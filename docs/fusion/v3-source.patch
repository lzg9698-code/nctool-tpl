+"""
+统一错误处理框架
+提供全局异常捕获和用户友好的错误提示
+"""
+
+import contextlib
+import logging
+import os
+import traceback
+from datetime import datetime
+from tkinter import messagebox
+from typing import Any, Optional
+
+from core.error_messages import ERROR_MESSAGES, format_error_with_context, get_user_friendly_message
+
+
+def _dialog_disabled() -> bool:
+    """检测当前环境是否应禁用错误对话框
+
+    设置环境变量 NC_NO_DIALOG=1 时（如自动化测试、后台任务），
+    错误处理降级为仅记录日志，避免模态对话框挂起无人响应。
+    """
+    return os.environ.get("NC_NO_DIALOG") == "1"
+
+
+class ErrorHandler:
+    """统一错误处理器"""
+
+    def __init__(self, log_file_path: Optional[str] = None) -> None:
+        """初始化错误处理器"""
+        self.log_file_path = log_file_path or self._get_default_log_path()
+        self._setup_logging()
+
+    def _get_default_log_path(self) -> str:
+        """获取默认日志文件路径"""
+        return os.path.join(os.path.expanduser("~"), "nc_tool_error.log")
+
+    def _setup_logging(self) -> None:
+        """设置日志记录"""
+        # 创建日志目录（如果不存在）
+        log_dir = os.path.dirname(self.log_file_path)
+        if log_dir and not os.path.exists(log_dir):
+            # 如果创建目录失败，继续使用默认路径
+            with contextlib.suppress(Exception):
+                os.makedirs(log_dir)
+
+        # 配置日志记录器
+        self.logger = logging.getLogger("NC_Tool_ErrorHandler")
+        self.logger.setLevel(logging.DEBUG)
+        self.logger.propagate = False
+
+        # 避免重复添加处理器
+        if not self.logger.handlers:
+            formatter = logging.Formatter("%(asctime)s - %(name)s - %(levelname)s - %(message)s")
+            try:
+                # 文件处理器（首选）
+                file_handler = logging.FileHandler(self.log_file_path, encoding="utf-8")
+                file_handler.setLevel(logging.DEBUG)
+                file_handler.setFormatter(formatter)
+                self.logger.addHandler(file_handler)
+            except Exception:
+                # 降级到标准错误输出，避免错误处理链路再次崩溃
+                stream_handler = logging.StreamHandler()
+                stream_handler.setLevel(logging.DEBUG)
+                stream_handler.setFormatter(formatter)
+                self.logger.addHandler(stream_handler)
+
+    def log_error(
+        self,
+        error: Any,
+        context: str = "",
+        show_dialog: bool = True,
+        parent: Optional[Any] = None,
+        level: str = "error",
+    ) -> str:
+        """
+        记录错误并可选择性地显示给用户
+
+        Args:
+            error: 异常对象或错误消息字符串
+            context: 错误上下文描述
+            show_dialog: 是否显示错误对话框
+            parent: 父窗口
+            level: 错误级别 ('error', 'warning', 'info')
+        """
+        # 获取详细的错误信息
+        error_msg = str(error)
+        error_type = type(error).__name__ if not isinstance(error, str) else "ManualError"
+
+        # 记录错误到日志
+        full_message = f"{context} - {error_type}: {error_msg}"
+
+        if level == "error":
+            self.logger.error(full_message)
+            if not isinstance(error, str):
+                self.logger.error(f"Traceback: {traceback.format_exc()}")
+        elif level == "warning":
+            self.logger.warning(full_message)
+        else:
+            self.logger.info(full_message)
+
+        # 如果需要，显示用户友好的错误对话框（测试/无 GUI 环境下降级为仅记录日志）
+        if show_dialog and not _dialog_disabled():
+            self._show_error_dialog(error_msg, context, parent, level)
+
+        return full_message
+
+    def _show_error_dialog(
+        self,
+        error_msg: str,
+        context: str = "",
+        parent: Optional[Any] = None,
+        level: str = "error",
+    ) -> None:
+        """显示错误对话框"""
+        try:
+            # 尝试从错误消息中提取错误代码
+            error_code = "UNKNOWN_ERROR"
+            for code in ERROR_MESSAGES:
+                if code in error_msg:
+                    error_code = code
+                    break
+
+            # 构造用户友好的错误消息
+            if context:
+                user_message = format_error_with_context(error_code, context, error_msg)
+            else:
+                user_message = get_user_friendly_message(error_code, error_msg)
+
+            if level == "error":
+                user_message += f"\n\n详细信息已记录到: {self.log_file_path}"
+
+            # 显示对话框
+            title_map = {"error": "错误", "warning": "警告", "info": "提示"}
+            title = title_map.get(level, "提示")
+
+            if level == "error":
+                messagebox.showerror(title, user_message, parent=parent)
+            elif level == "warning":
+                messagebox.showwarning(title, user_message, parent=parent)
+            else:
+                messagebox.showinfo(title, user_message, parent=parent)
+        except Exception:
+            pass
+
+    def handle_critical_error(self, error: Any, context: str = "") -> None:
+        """
+        处理严重错误（如程序启动失败）
+        这种情况下会记录错误并显示详细信息
+        """
+        error_msg = str(error)
+        error_type = type(error).__name__
+
+        # 记录详细错误信息
+        full_message = f"严重错误 [{context}] - {error_type}: {error_msg}"
+        self.logger.critical(full_message)
+        self.logger.critical(f"Traceback: {traceback.format_exc()}")
+
+        # 尝试显示错误信息（测试/无 GUI 环境下降级为仅记录日志）
+        try:
+            if _dialog_disabled():
+                print(f"严重错误: {full_message}")
+                print(f"Traceback: {traceback.format_exc()}")
+                return
+            detailed_message = (
+                f"程序遇到严重错误:\n{error_msg}\n\n"
+                f"错误类型: {error_type}\n"
+                f"上下文: {context}\n\n"
+                f"详细信息已记录到: {self.log_file_path}\n"
+                f"时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
+            )
+            messagebox.showerror("严重错误", detailed_message)
+        except Exception:
+            # 如果连消息框都无法显示，将错误输出到控制台
+            print(f"严重错误: {full_message}")
+            print(f"Traceback: {traceback.format_exc()}")
+
+
+# 全局错误处理器实例
+_error_handler = None
+
+
+def get_error_handler() -> ErrorHandler:
+    """获取全局错误处理器实例"""
+    global _error_handler
+    if _error_handler is None:
+        _error_handler = ErrorHandler()
+    return _error_handler
+
+
+def handle_exception(
+    error: Any,
+    context: str = "",
+    show_dialog: bool = True,
+    parent: Optional[Any] = None,
+    level: str = "error",
+) -> str:
+    """
+    全局异常处理函数
+    """
+    handler = get_error_handler()
+    return handler.log_error(error, context, show_dialog, parent, level)
+
+
+def handle_critical_error(error: Any, context: str = "") -> None:
+    """
+    处理严重错误
+    """
+    handler = get_error_handler()
+    handler.handle_critical_error(error, context)
