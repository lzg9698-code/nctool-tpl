+import unittest
+
+from core.error_handler import ErrorHandler, handle_exception
+from core.error_messages import CNC_DATA_CONFLICT, CNC_INVALID_PARAM
+
+
+class TestErrorHandling(unittest.TestCase):
+    def test_error_code_extraction(self):
+        # This test relies on handle_exception behavior.
+        # Since handle_exception shows a dialog in actual use, we'll just test the logic if possible,
+        # or mock the message box.
+
+        with (
+            unittest.mock.patch("customtkinter.CTkLabel"),
+            unittest.mock.patch("tkinter.messagebox.showerror"),
+        ):
+            # Test with CNC error code in message
+            try:
+                raise ValueError(f"{CNC_DATA_CONFLICT}: conflict info")
+            except Exception as e:
+                handle_exception(e, "Test")
+
+                # Verify that the message box was called (or at least no crash)
+                # In headless environment this might be tricky, but we can verify it doesn't crash
+                pass
+
+    def test_cnc_error_messages(self):
+        from core.error_messages import ERROR_MESSAGES
+
+        self.assertIn(CNC_DATA_CONFLICT, ERROR_MESSAGES)
+        self.assertIn(CNC_INVALID_PARAM, ERROR_MESSAGES)
+
+    def test_logger_fallback_when_file_handler_fails(self):
+        with unittest.mock.patch("logging.FileHandler", side_effect=PermissionError("denied")):
+            handler = ErrorHandler(log_file_path="C:/denied/path.log")
+            self.assertTrue(len(handler.logger.handlers) > 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
