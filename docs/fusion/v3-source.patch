+class UndercutRow(ctk.CTkFrame):
+    """单行越程槽设置 (从 undercut_logic 导入数据库)"""
+
+    def __init__(self, master, index, delete_callback, ES_GROOVE_DB, FS_GROOVE_DB, **kwargs):
+        super().__init__(master, fg_color=("#FDFDFD", "#2B2B2B"), corner_radius=6, **kwargs)
+        self.index = index
+        self.delete_callback = delete_callback
+        self.ES_GROOVE_DB = ES_GROOVE_DB
+        self.FS_GROOVE_DB = FS_GROOVE_DB
+
+        self.seq_label = ctk.CTkLabel(self, text=str(index + 1), width=30)
+        self.seq_label.grid(row=0, column=0, padx=2, pady=1)
+
+        self.type_var = ctk.StringVar(value="ES")
+        self.btn_type = ctk.CTkButton(
+            self,
+            textvariable=self.type_var,
+            width=70,
+            height=28,
+            command=self._toggle_type,
+            fg_color=COLOR_SECONDARY,
+            hover_color=COLOR_HOVER_PRIMARY,
+        )
+        self.btn_type.grid(row=0, column=1, padx=2, pady=1)
+
+        self.cb_std = ctk.CTkComboBox(self, values=[], width=150, state="readonly")
+        self.cb_std.grid(row=0, column=2, padx=2, pady=1)
+
+        self.entries = {}
+        self._keys = ["d1", "z", "d2", "c", "ang"]
+        for i, key in enumerate(self._keys):
+            entry = ctk.CTkEntry(self, width=60)
+            entry.grid(row=0, column=3 + i, padx=2, pady=1)
+            entry.bind("<Return>", lambda _, k=key: self._focus_next(k))
+            self.entries[key] = entry
+
+        self._update_button_style("ES")
+        self._on_type_change()
+
+    def _toggle_type(self):
+        """切换 ES/FS 类型"""
+        current = self.type_var.get()
+        new_type = "FS" if current == "ES" else "ES"
+        self.type_var.set(new_type)
+        self._update_button_style(new_type)
+        self._on_type_change(new_type)
+
+    def _update_button_style(self, gtype):
+        """根据类型更新按钮颜色"""
+        if gtype == "ES":
+            # ES 使用蓝色系
+            self.btn_type.configure(fg_color=COLOR_PRIMARY, hover_color=COLOR_HOVER_PRIMARY)
+        else:
+            # FS 使用紫色系
+            self.btn_type.configure(fg_color=COLOR_ACTION, hover_color=COLOR_HOVER_ACTION)
+
+    def _on_type_change(self, choice=None):
+        gtype = self.type_var.get()
+        if gtype == "ES":
+            standards = list(self.ES_GROOVE_DB.keys())
+            for k in ["d2", "c", "ang"]:
+                self.entries[k].configure(
+                    state="normal", fg_color=[COLOR_ENTRY_LIGHT, COLOR_ENTRY_DARK]
+                )
+        else:
+            standards = list(self.FS_GROOVE_DB.keys())
+            for k in ["d2", "c", "ang"]:
+                self.entries[k].delete(0, "end")
+                self.entries[k].configure(state="disabled", fg_color="gray")
+
+        self.cb_std.configure(values=standards)
+        if standards:
+            self.cb_std.set(standards[0])
+
+    def get_data(self):
+        return {
+            "type": self.type_var.get(),
+            "std": self.cb_std.get(),
+            "d1": self.entries["d1"].get(),
+            "z": self.entries["z"].get(),
+            "d2": self.entries["d2"].get(),
+            "c": self.entries["c"].get(),
+            "ang": self.entries["ang"].get(),
+        }
+
+    def set_data(self, data):
+        if "type" in data:
+            gtype = data.get("type")
+            self.type_var.set(gtype)
+            self._update_button_style(gtype)
+            self._on_type_change()
+        if "std" in data:
+            self.cb_std.set(data.get("std"))
+        for k in ["d1", "z", "d2", "c", "ang"]:
+            if k in data:
+                self.entries[k].delete(0, "end")
+                self.entries[k].insert(0, str(data[k]))
+
+    def _focus_next(self, current_key: str):
+        try:
+            idx = self._keys.index(current_key)
+        except ValueError:
+            return
+        for next_idx in range(idx + 1, len(self._keys)):
+            key = self._keys[next_idx]
+            widget = self.entries.get(key)
+            if widget and str(widget.cget("state")) == "normal":
+                self._focus_widget(widget)
+                return
+        siblings = [w for w in self.master.winfo_children() if isinstance(w, UndercutRow)]
+        try:
+            row_index = siblings.index(self)
+        except ValueError:
+            return
+        for next_row in siblings[row_index + 1 :]:
+            for key in next_row._keys:
+                widget = next_row.entries.get(key)
+                if widget and str(widget.cget("state")) == "normal":
+                    next_row._focus_widget(widget)
+                    return
+
+    def _focus_widget(self, widget):
+        _focus_widget(widget)
