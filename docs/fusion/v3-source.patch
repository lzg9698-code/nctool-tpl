+"""
+越程槽生成器独立入口
+------------------
+提供仅包含“越程槽生成”功能的独立应用。
+"""
+
+import sys
+from contextlib import suppress
+
+import customtkinter as ctk
+
+from core.error_handler import handle_critical_error
+from core.template_engine import TemplateParser
+from core.undercut_logic import GrooveGenerator
+from core.utils import COLOR_SECONDARY, get_config_path
+from core.variable_manager import VariableRepository
+from ui.resource_manager import UIManager
+from ui.undercut_frame import UndercutGeneratorFrame
+
+VERSION = "V3.0"
+APP_TITLE = f"数控工具{VERSION} - 越程槽生成器"
+
+
+class UndercutStandaloneApp(ctk.CTk):
+    """越程槽生成器独立应用"""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.title(APP_TITLE)
+
+        self.ui_manager = UIManager(self)
+        self.ui_manager.center_window(self, 1250, 800)
+        self.ui_manager.setup_app_icon()
+        ctk.set_appearance_mode("light")
+
+        self._init_services()
+        self._build_ui()
+
+    def _init_services(self) -> None:
+        """初始化核心服务"""
+        templates_dir = get_config_path("templates")
+        self.template_parser = TemplateParser(str(templates_dir))
+        self.groove_generator = GrooveGenerator(parser=self.template_parser)
+
+        repo_path = get_config_path("variable_repo.json")
+        self.variable_repo = VariableRepository(str(repo_path))
+
+    def _build_ui(self) -> None:
+        self.grid_columnconfigure(0, weight=1)
+        self.grid_rowconfigure(0, weight=1)
+        self.grid_rowconfigure(1, weight=0)
+
+        self.undercut_frame = UndercutGeneratorFrame(
+            self,
+            groove_generator=self.groove_generator,
+            variable_repo=self.variable_repo,
+            status_callback=self._update_status,
+        )
+        self.undercut_frame.grid(row=0, column=0, sticky="nsew", padx=4, pady=(4, 2))
+
+        self._build_status_bar()
+        self._update_status("越程槽生成器已就绪", "success")
+
+    def _build_status_bar(self) -> None:
+        """创建底部状态栏"""
+        self.status_frame = ctk.CTkFrame(
+            self,
+            fg_color=("#FDFDFD", "#2B2B2B"),
+            corner_radius=10,
+            border_width=0,
+        )
+        self.status_frame.grid(row=1, column=0, sticky="ew", padx=0, pady=0)
+        self.status_frame.grid_columnconfigure(0, weight=1)
+
+        self.status_label = ctk.CTkLabel(
+            self.status_frame,
+            text="就绪",
+            anchor="w",
+            fg_color="transparent",
+            text_color="gray",
+            font=ctk.CTkFont(size=12),
+        )
+        self.status_label.grid(row=0, column=0, sticky="ew", padx=4, pady=2)
+
+        self.topmost_btn = ctk.CTkButton(
+            self.status_frame,
+            text="置顶",
+            width=60,
+            height=24,
+            command=self._toggle_topmost,
+            fg_color=COLOR_SECONDARY,
+            hover_color="#4a5a6e",
+        )
+        self.topmost_btn.grid(row=0, column=1, padx=2, pady=2)
+
+        self.theme_btn = ctk.CTkButton(
+            self.status_frame,
+            text="明/暗",
+            width=60,
+            height=24,
+            command=self._toggle_appearance,
+            fg_color=COLOR_SECONDARY,
+            hover_color="#4a5a6e",
+        )
+        self.theme_btn.grid(row=0, column=2, padx=2, pady=2)
+
+        self.refresh_btn = ctk.CTkButton(
+            self.status_frame,
+            text="刷新配置",
+            width=90,
+            height=24,
+            command=self._refresh_all,
+            fg_color=COLOR_SECONDARY,
+            hover_color="#4a5a6e",
+        )
+        self.refresh_btn.grid(row=0, column=3, padx=(2, 4), pady=2)
+
+    def _update_status(self, message: str, level: str = "info") -> None:
+        colors = {"success": "#28a745", "error": "#dc3545", "warn": "#ffc107", "info": "gray"}
+        color = colors.get(level, "gray")
+        content = message[:100] + "..." if len(message) > 100 else message
+        self.status_label.configure(text=f"[{level.upper()}] {content}", text_color=color)
+
+        if hasattr(self, "_status_after_id") and self._status_after_id is not None:
+            with suppress(Exception):
+                # 定时器可能已失效，取消失败时静默忽略
+                self.after_cancel(self._status_after_id)
+        self._status_after_id = self.after(
+            5000, lambda: self.status_label.configure(text="就绪", text_color="gray")
+        )
+
+    def _toggle_topmost(self) -> None:
+        try:
+            is_topmost = self.ui_manager.toggle_topmost()
+            self.topmost_btn.configure(text="取消置顶" if is_topmost else "置顶")
+        except Exception as e:
+            self._update_status(f"置顶切换失败: {str(e)}", "error")
+
+    def _toggle_appearance(self) -> None:
+        try:
+            mode = self.ui_manager.toggle_appearance()
+            self._update_status(f"已切换为 {mode} 模式", "info")
+        except Exception as e:
+            self._update_status(f"主题切换失败: {str(e)}", "error")
+
+    def _refresh_all(self) -> None:
+        """刷新模板、变量仓库与界面配置"""
+        try:
+            self.template_parser.reload_config()
+            self.variable_repo.load()
+            self.undercut_frame.load_config()
+            self._update_status("配置已刷新", "success")
+        except Exception as e:
+            self._update_status(f"刷新配置失败: {str(e)}", "error")
+
+
+def main() -> None:
+    try:
+        app = UndercutStandaloneApp()
+        app.mainloop()
+    except Exception as e:
+        handle_critical_error(e, "越程槽独立应用主循环")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except KeyboardInterrupt:
+        sys.exit(0)
