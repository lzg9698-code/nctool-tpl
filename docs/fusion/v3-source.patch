+            else:
+                self._log(f"预览匹配失败: {filename} 不在预览组件列表中", "warn")
+
+        self._log(f"预览已更新: 成功匹配 {matched_count}/{len(results)} 个文件", "info")
+        self._preview_refresh_time = datetime.now()
+        self.lbl_refresh_time.configure(
