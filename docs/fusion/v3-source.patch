+def _focus_widget(widget: Any) -> None:
+    """将焦点移动到目标控件并全选内容
+
+    不同控件类型对全选的支持不同，统一做防御性处理；
+    焦点转移失败时静默忽略，不打断用户输入流程。
+    """
+    try:
+        widget.focus_set()
+        if hasattr(widget, "select_range"):
+            widget.select_range(0, "end")
+        if hasattr(widget, "icursor"):
+            widget.icursor("end")
+    except Exception:
+        pass
