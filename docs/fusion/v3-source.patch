+class DynamicInputFrame(ctk.CTkFrame):
+    """动态输入框架 (基础容器版)"""
+
+    def __init__(self, master, variable_repo, value_change_callback=None, **kwargs):
+        # 如果 kwargs 中已经包含 fg_color，则不传递默认值
+        if "fg_color" in kwargs:
+            super().__init__(master, **kwargs)
+        else:
+            super().__init__(master, fg_color="transparent", **kwargs)
+        self.variable_repo = variable_repo
+        self.value_change_callback = value_change_callback
+        self.input_widgets: dict[str, Any] = {}
+        self.labels: dict[str, ctk.CTkLabel] = {}
+        self.input_order: list[str] = []
+
+    def clear(self) -> None:
+        for widget in self.winfo_children():
+            widget.destroy()
+        self.input_widgets.clear()
+        self.labels.clear()
+        self.input_order.clear()
+
+    def build_inputs(self, variables: list[str]) -> None:
+        """构建输入控件"""
+        try:
+            self.clear()
+
+            if not variables:
+                empty_label = ctk.CTkLabel(
+                    self,
+                    text="没有变量需要输入",
+                    font=ctk.CTkFont(family=FONT_FAMILY, size=14, slant="italic"),
+                    text_color="gray",
+                )
+                empty_label.pack(expand=True, pady=10)
+                return
+
+            # 按类型和字母顺序对变量进行排序，保持界面逻辑一致
+            type_priority = {"choice": 0, "int": 1, "float": 2, "bool": 3, "str": 4}
+
+            def get_sort_key(v):
+                dt = self.variable_repo.get_data_type(v)
+                p = type_priority.get(dt, 99)
+                return (p, v.lower())
+
+            sorted_vars = sorted(variables, key=get_sort_key)
+
+            self.grid_columnconfigure(0, weight=2)
+            self.grid_columnconfigure(1, weight=0)
+            self.grid_columnconfigure(2, weight=3)
+
+            self.input_order = []
+
+            for idx, var_name in enumerate(sorted_vars):
+                label_name = ctk.CTkLabel(
+                    self,
+                    text=f"{var_name}:",
+                    anchor="e",
+                    font=ctk.CTkFont(family=FONT_FAMILY, size=13, weight="bold"),
+                )
+                label_name.grid(row=idx, column=0, padx=(5, 2), pady=1, sticky="e")
+                self.labels[var_name] = label_name
+
+                data_type = self.variable_repo.get_data_type(var_name)
+                is_readonly = self.variable_repo.is_read_only(var_name)
+
+                if is_readonly:
+                    label_name.configure(
+                        text_color=COLOR_PRIMARY,
+                        font=ctk.CTkFont(family=FONT_FAMILY, size=13, weight="bold"),
+                    )
+
+                if data_type == "choice":
+                    # Get display texts and actual values with proper type conversion
+                    display_texts = self.variable_repo.get_options(var_name)
+                    option_values = self.variable_repo.get_option_values(var_name)
+
+                    # Create a mapping between display text and actual value
+                    if not hasattr(self, "option_mapping"):
+                        self.option_mapping = {}
+                    self.option_mapping.update(dict(zip(display_texts, option_values)))
+
+                    # Create a mapping from value to display text for reverse lookup
+                    if not hasattr(self, "value_to_display"):
+                        self.value_to_display = {}
+                    self.value_to_display.update(dict(zip(option_values, display_texts)))
+
+                    # Create the combobox widget
+                    widget = ctk.CTkComboBox(
+                        self,
+                        values=display_texts,
+                        width=90,  # Match width with other input fields
+                        height=28,  # Match height with other input fields
+                        font=ctk.CTkFont(family=FONT_FAMILY, size=13, weight="normal"),
+                        dropdown_font=ctk.CTkFont(family=FONT_FAMILY, size=13, weight="normal"),
+                        state="readonly",  # Start as readonly to allow initial set
+                        dropdown_fg_color=COLOR_LIGHT_BG,
+                        dropdown_text_color="#000000",
+                        dropdown_hover_color="#e0e0e0",
+                        button_color=COLOR_PRIMARY,
+                        button_hover_color=COLOR_HOVER_PRIMARY,
+                        fg_color=COLOR_ENTRY_LIGHT,
+                        text_color="#000000",
+                        border_color=COLOR_SECONDARY,
+                        border_width=1,
+                        corner_radius=4,
+                        justify="left",  # Align text to the left
+                        command=lambda _, v=var_name: self._on_input_change(v),
+                    )
+
+                    # Set default value if available
+                    default_val = self.variable_repo.get_default_value(var_name)
+                    if default_val is not None and default_val != "":
+                        display_text = self.value_to_display.get(default_val, str(default_val))
+                        if display_text in display_texts:
+                            widget.set(display_text)
+                        elif display_texts:  # If not found, set to first option
+                            widget.set(display_texts[0])
+
+                    # Apply final disabled state if readonly
+                    if is_readonly:
+                        widget.configure(state="disabled")
+                else:
+                    # For non-choice types, use standard entry field
+                    widget = ctk.CTkEntry(
+                        self,
+                        width=90,
+                        height=28,  # Explicitly set height to match combobox
+                        font=ctk.CTkFont(family=FONT_FAMILY, size=13),
+                        placeholder_text=str(self.variable_repo.get_default(var_name)),
+                        border_width=1,
+                        border_color=COLOR_SECONDARY,
+                        corner_radius=4,
+                        fg_color=COLOR_ENTRY_LIGHT if not is_readonly else "#f0f0f0",
+                        text_color="#000000",
+                        state="normal",  # Start as normal to allow initial insert
+                    )
+                    widget.bind("<KeyRelease>", lambda _, v=var_name: self._on_input_change(v))
+                    if not is_readonly:
+                        self.input_order.append(var_name)
+                        widget.bind("<Return>", lambda _, v=var_name: self._focus_next_input(v))
+
+                    # Set default value if available
+                    default_val = self.variable_repo.get_default(var_name)
+                    if default_val is not None and str(default_val) != "":
+                        widget.insert(0, str(default_val))
+
+                    # Apply final disabled state if readonly
+                    if is_readonly:
+                        widget.configure(state="disabled")
+
+                widget.grid(row=idx, column=1, padx=2, pady=1, sticky="")
+
+                self.input_widgets[var_name] = widget
+
+                description = self.variable_repo.get_description(var_name)
+                desc_text = description if description and description != var_name else ""
+
+                # Create a frame for description and error message
+                desc_container = ctk.CTkFrame(self, fg_color="transparent")
+                desc_container.grid(row=idx, column=2, padx=(2, 5), pady=1, sticky="w")
+
+                label_desc = ctk.CTkLabel(
+                    desc_container,
+                    text=desc_text,
+                    anchor="w",
+                    font=ctk.CTkFont(family=FONT_FAMILY, size=13, weight="normal"),
+                )
+                label_desc.pack(side="left")
+
+                error_label = ctk.CTkLabel(
+                    desc_container,
+                    text="",
+                    text_color="red",
+                    anchor="w",
+                    font=ctk.CTkFont(family=FONT_FAMILY, size=11),
+                )
+                error_label.pack(side="left", padx=5)
+
+                self.labels[var_name] = label_name
+                self.error_labels = getattr(self, "error_labels", {})
+                self.error_labels[var_name] = error_label
+        except Exception as e:
+            handle_exception(e, "构建输入控件")
+            # 这里不直接显示错误，因为这是UI构建过程中的错误
