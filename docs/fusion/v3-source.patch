+    def _generate_all(self):
+        """执行批量生成并保存文件 (多线程)"""
+        scheme_name = self.scheme_var.get()
+        scheme = self.scheme_map.get(scheme_name)
+        if not scheme:
+            return
+
+        # 选择保存目录 (必须在主线程执行)
+        save_dir = filedialog.askdirectory(title="选择保存代码方案的目录")
+        if not save_dir:
+            return
+
+        def generate_thread():
+            try:
+                # 禁用按钮防止重复点击
+                self.after(
+                    0, lambda: self.btn_generate.configure(state="disabled", text="正在生成...")
+                )
+
+                inputs = self.dynamic_input.get_values()
+                results = self.service.render_scheme(scheme.id, inputs, update_defaults=True)
+
+                saved_files = []
+                for t in scheme.templates:
+                    content = results.get(f"{t.output_name}{t.extension}")
+                    if content is None:
+                        continue
+
+                    final_filename = f"{t.output_name}{t.extension}"
+                    file_path = Path(save_dir) / final_filename
+                    with open(file_path, "w", encoding="utf-8") as f:
+                        f.write(content)
+                    saved_files.append(final_filename)
+
+                # 更新 UI
+                self.after(
+                    0,
+                    lambda: self._show_status(
+                        f"成功生成方案 '{scheme_name}'，共 {len(saved_files)} 个文件", COLOR_SUCCESS
+                    ),
+                )
+
+            except VariableInputValidationError as e:
+                self.after(0, lambda err=e: handle_exception(err, "参数校验失败"))
+            except Exception as e:
+                self.after(0, lambda err=e: handle_exception(err, "生成方案代码失败"))
+            finally:
+                # 恢复按钮状态
+                self.after(0, lambda: self.btn_generate.configure(state="normal", text="批量生成"))
+
+        threading.Thread(target=generate_thread, daemon=True).start()
