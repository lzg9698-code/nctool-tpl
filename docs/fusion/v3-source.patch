+"""
+同步车削核心代码
+包含同步车削相关的类和函数
+"""
+import math
+from typing import Any
+
+from core.interfaces import TemplateLoader
+from core.models import SyncTurningConfig
+
+
+class BaseSyncTurningGenerator:
+    """同步车削生成器基类：提供参数校验、刀次计算与双通道渲染公共逻辑"""
+
+    def __init__(self, parser: TemplateLoader):
+        # 初始化模板解析器
+        self.template_parser = parser
+
+    # ------------------------------------------------------------------
+    # 公共计算逻辑
+    # ------------------------------------------------------------------
+
+    def _validate_parameters(self, ap_1: float, ap_2: float, sync_feed: float) -> list[str]:
+        """校验切削参数，返回超限警告列表"""
+        warnings = []
+        if ap_1 > 5:
+            warnings.append(f";警告: ap_1={ap_1} 超出上限5")
+        if ap_2 > 8:
+            warnings.append(f";警告: ap_2={ap_2} 超出上限8")
+        if sync_feed > 0.5:
+            warnings.append(f";警告: 同步进给 sync_feed={sync_feed} 超出上限0.5")
+        return warnings
+
+    def _calculate_cut_count(self, sta_x: float, end_x: float, ap_1: float, ap_2: float) -> int:
+        """计算切削刀次
+
+        总余量按 (ap_1+ap_2) 等分；余量接近整数倍时按整数刀次，
+        否则向上取整。参数非法或无需切削时返回 0。
+        """
+        total_dia = sta_x - end_x
+        if total_dia <= 0:
+            return 0
+        step = ap_1 + ap_2
+        if step <= 0:
+            return 0
+
+        ratio = total_dia / step
+        if ratio <= 0:
+            return 0
+
+        n_round = int(round(ratio))
+        eps = 1e-8
+        if n_round > 0 and abs(ratio - n_round) <= eps:
+            return n_round
+
+        return math.ceil(ratio)
+
+    def _calculate_actual_start_x(
+        self, end_x: float, cut_num: int, ap_1: float, ap_2: float
+    ) -> float:
+        """计算实际起始直径（按整数刀次反推）"""
+        return end_x + cut_num * (ap_1 + ap_2)
+
+    def _render_channels(self, template_name: str, context: dict[str, Any]) -> tuple[str, str]:
+        """渲染双通道 G-code：同一模板分别注入 channel=1 / channel=2
+
+        返回:
+            (通道1代码, 通道2代码)
+        """
+        context_ch1 = context.copy()
+        context_ch1["channel"] = 1
+
+        context_ch2 = context.copy()
+        context_ch2["channel"] = 2
+
+        gcode_ch1 = self.template_parser.render_template(template_name, context_ch1)
+        gcode_ch2 = self.template_parser.render_template(template_name, context_ch2)
+
+        return gcode_ch1, gcode_ch2
+
+
+class RightSideGenerator(BaseSyncTurningGenerator):
+    """右侧同步车削生成器"""
+
+    def generate(
+        self,
+        sta_x: float,
+        sta_z: float,
+        end_x: float,
+        end_z: float,
+        sync_feed: float,
+        ap_1: float,
+        ap_2: float,
+        current_sync_num: int,
+    ) -> tuple[str, str, int]:
+        """
+        生成右侧同步车削G代码
+
+        返回:
+            (通道1代码, 通道2代码, 下一个可用同步编号)
+        """
+        warnings = self._validate_parameters(ap_1, ap_2, sync_feed)
+        cut_num = self._calculate_cut_count(sta_x, end_x, ap_1, ap_2)
+
+        if cut_num == 0:
+            return ";(No cutting required)", ";(No cutting required)", current_sync_num
+
+        actual_sta_x = self._calculate_actual_start_x(end_x, cut_num, ap_1, ap_2)
+
+        # 准备模板上下文
+        context = {
+            "side": "Right",
+            "end_x": end_x,
+            "sta_z": sta_z,
+            "actual_sta_x": actual_sta_x,
+            "end_z": end_z,
+            "sync_feed": sync_feed,
+            "ap_1": ap_1,
+            "ap_2": ap_2,
+            "cut_num": int(cut_num),
+            "sync_num_start": current_sync_num,
+            "warnings": warnings,
+        }
+
+        # 使用模板生成G代码
+        gcode_ch1, gcode_ch2 = self._render_channels("sync_turning_right_template.j2", context)
+
+        # 计算下一个可用的同步编号
+        next_sync_num = current_sync_num + int(cut_num) + 1
+
+        return gcode_ch1, gcode_ch2, next_sync_num
+
+
+class LeftSideGenerator(BaseSyncTurningGenerator):
+    """左侧同步车削生成器"""
+
+    def generate(
+        self,
+        sta_x: float,
+        sta_z: float,
+        end_x: float,
+        end_z: float,
+        sync_feed: float,
+        ap_1: float,
+        ap_2: float,
+        current_sync_num: int,
+    ) -> tuple[str, str, int]:
+        """
+        生成左侧同步车削G代码
+
+        返回:
+            (通道1代码, 通道2代码, 下一个可用同步编号)
+        """
+        cut_num = self._calculate_cut_count(sta_x, end_x, ap_1, ap_2)
+        if cut_num == 0:
+            return ";No cut", ";No cut", current_sync_num
+
+        actual_sta_x = self._calculate_actual_start_x(end_x, cut_num, ap_1, ap_2)
+        actual_sta_z = sta_z + ((actual_sta_x - sta_x) / 2) / math.tan(math.radians(25)) - 2
+
+        # 准备模板上下文
+        context = {
+            "side": "Left",
+            "end_x": end_x,
+            "sta_x": sta_x,
+            "actual_sta_z": actual_sta_z,
+            "actual_sta_x": actual_sta_x,
+            "end_z": end_z,
+            "sync_feed": sync_feed,
+            "ap_1": ap_1,
+            "ap_2": ap_2,
+            "cut_num": int(cut_num),
+            "sync_num_start": current_sync_num,
+        }
+
+        # 使用模板生成G代码
+        gcode_ch1, gcode_ch2 = self._render_channels("sync_turning_left_template.j2", context)
+
+        # 计算下一个可用的同步编号
+        next_sync_num = current_sync_num + int(cut_num) + 1
+
+        return gcode_ch1, gcode_ch2, next_sync_num
+
+
+def _process_batch(
+    config: SyncTurningConfig, generator: BaseSyncTurningGenerator
+) -> tuple[list[str], list[str]]:
+    """批量处理同步车削案例，返回 (通道1代码列表, 通道2代码列表)"""
+    current_sync = config.start_sync_num
+    gc1, gc2 = [], []
+
+    for c in config.cases:
+        r1, r2, next_sync = generator.generate(
+            c.sta_x, c.sta_z, c.end_x, c.end_z, config.sync_feed, c.ap_1, c.ap_2, current_sync
+        )
+        gc1.append(r1)
+        gc2.append(r2)
+        current_sync = next_sync
+
+    return gc1, gc2
+
+
+def process_right_batch(
+    config: SyncTurningConfig, generator: RightSideGenerator
+) -> tuple[list[str], list[str]]:
+    """批量生成右侧同步车削 G-code，返回 (通道1代码列表, 通道2代码列表)"""
+    return _process_batch(config, generator)
+
+
+def process_left_batch(
+    config: SyncTurningConfig, generator: LeftSideGenerator
+) -> tuple[list[str], list[str]]:
+    """批量生成左侧同步车削 G-code，返回 (通道1代码列表, 通道2代码列表)"""
+    return _process_batch(config, generator)
+
+
+def recommend_sync_parameters(
+    sta_x: float, end_x: float, ap1_fixed: float, ap2_min: float, ap2_max: float
+) -> tuple[int, float, float] | None:
+    """
+    计算推荐的同步车削参数
+
+    Args:
+        sta_x: 起始直径
+        end_x: 结束直径
+        ap1_fixed: 固定切深1
+        ap2_min: 最小切深2
+        ap2_max: 最大切深2
+
+    Returns:
+        tuple: (刀次n, ap1, ap2) 或 None (如果找不到合适的参数)
+    """
+    total_dia = sta_x - end_x
+    if total_dia <= 0:
+        return None
+    if ap2_min < 0 or ap2_max <= 0 or ap2_max < ap2_min:
+        return None
+    eps = 1e-9
+
+    # 尝试寻找合适的刀次 n
+    for n in range(1, 5000):
+        d_avg = total_dia / n
+        # 如果平均切深过大，说明刀次太少，继续增加刀次
+        if d_avg > (ap1_fixed + ap2_max + eps):
+            continue
+        # 如果平均切深过小，说明刀次太多，已无解（因为n是递增的），中断
+        if d_avg < (ap1_fixed + ap2_min - eps):
+            break
+
+        ap2 = d_avg - ap1_fixed
+        if (ap2_min - eps) <= ap2 <= (ap2_max + eps):
+            return n, ap1_fixed, ap2
+
+    # 特殊情况处理：如果总余量小于最小切深组合，尝试只切一刀
+    if total_dia < (ap1_fixed + ap2_min):
+        return 1, ap1_fixed, max(ap2_min, min(ap2_max, total_dia))
+
+    return None
+
+
+def batch_recommend_sync_parameters(
+    rows_data: list[dict[str, Any]], ap1_fixed: float, ap2_min: float, ap2_max: float
+) -> tuple[list[dict[str, Any]], int, int, int | None]:
+    """
+    批量计算推荐参数
+
+    Returns:
+        tuple: (results, ok_count, fail_count, last_n)
+    """
+    results = []
+    ok, fail, last_n = 0, 0, None
+
+    for i, row in enumerate(rows_data):
+        try:
+            sta_x = float(row.get("sta_x", 0))
+            end_x = float(row.get("end_x", 0))
+            rec = recommend_sync_parameters(sta_x, end_x, ap1_fixed, ap2_min, ap2_max)
+            if rec:
+                n, ap1_rec, ap2_rec = rec
+                last_n = n
+                results.append(
+                    {
+                        "index": i,
+                        "cut_num": n,  # 切削刀数
+                        "ap_2": ap2_rec,
+                        "success": True,
+                    }
+                )
+                ok += 1
+            else:
+                results.append({"index": i, "success": False})
+                fail += 1
+        except (ValueError, TypeError):
+            results.append({"index": i, "success": False})
+            fail += 1
+
+    return results, ok, fail, last_n
