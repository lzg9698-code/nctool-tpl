+def format_float_clean(v: float) -> str:
+    """
+    格式化浮点数，去除末尾的0和小数点
+
+    Args:
+        v: 浮点数
+
+    Returns:
+        str: 格式化后的字符串
+    """
+    s = f"{v:.6f}".rstrip("0").rstrip(".")
+    return s if s else "0"
+
+
+def format_float_2_decimal(v: float) -> str:
+    """
+    格式化浮点数，保留两位小数，向上取整（进一法）
+
+    Args:
+        v: 浮点数
+
+    Returns:
+        str: 保留两位小数的字符串
+    """
+    # 将数值乘以100，向上取整，然后除以100
+    rounded_value = math.ceil(v * 100) / 100
+    return f"{rounded_value:.2f}"
