+# 越程槽模板已移至 undercut_template.j2 模板文件
+class GrooveGenerator:
+    """越程槽生成器逻辑"""
+
+    def __init__(self, parser: TemplateLoader):
+        """初始化越程槽生成器，加载模板解析器"""
+        self.template_parser = parser
+
+    # ------------------------------------------------------------------
+    # 公共计算
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _calc_start_geometry(
+        ang: float, f: float, safety_dis: float, z: float, side: str, d1: float, t1: float
+    ) -> tuple[float, float, float, float]:
+        """计算槽起始几何参数（ES / FS 共享的公共部分）
+
+        参数:
+            ang: 槽侧角（度）
+            f: 进给/偏移量
+            safety_dis: 安全距离
+            z: 槽 Z 位置
+            side: "Right" / "Left"
+            d1: 槽起始直径
+            t1: 槽深
+
+        返回:
+            (z_start, d1_cut, ang_1, d1_comp_start)
+        """
+        tan_ang = math.tan(math.radians(ang)) if ang != 0 else float("inf")
+        z_start_offset = f + safety_dis / tan_ang
+        z_start = z + z_start_offset if side == "Right" else z - z_start_offset
+        d1_cut = d1 - 2 * t1
+        ang_1 = ang - 180 if side == "Right" else -ang
+        d1_comp_start = d1 + 2 * safety_dis
+        return z_start, d1_cut, ang_1, d1_comp_start
+
+    # ------------------------------------------------------------------
+    # 生成逻辑
+    # ------------------------------------------------------------------
+
+    def generate(
+        self,
+        gtype: str,
+        side: str,
+        raw_diameter: float,
+        safety_dis: float,
+        std_key: str,
+        ES_d1: float | None = None,
+        ES_z: float | None = None,
+        ES_d2: float | None = None,
+        ES_c: float | None = None,
+        ES_c_ang: float | None = None,
+        FS_d1: float | None = None,
+        FS_z: float | None = None,
+    ) -> str:
+        """
+        生成越程槽G代码
+
+        Raises:
+            ValueError: 当输入参数无效或缺失时
+            TemplateRenderError: 当模板渲染失败时
+        """
+        gtype = gtype.upper()
+
+        # 1. 选择数据库并获取标准参数
+        if gtype == "ES":
+            db = ES_GROOVE_DB
+            required_user_params = [ES_d1, ES_z, ES_d2, ES_c, ES_c_ang]
+        elif gtype == "FS":
+            db = FS_GROOVE_DB
+            required_user_params = [FS_d1, FS_z]
+        else:
+            raise ValueError("Invalid groove type. Must be 'ES' or 'FS'.")
+
+        if std_key not in db:
+            raise ValueError(f"Unknown Standard '{std_key}' for type {gtype}.")
+
+        # 检查必需的用户输入参数是否完整
+        if any(p is None for p in required_user_params):
+            raise ValueError(f"Missing required parameters for {gtype}")
+
+        # 检查 D1 是否大于等于毛坯直径
+        d1_val = ES_d1 if gtype == "ES" else FS_d1
+        if d1_val is not None and d1_val >= raw_diameter:
+            raise ValueError(
+                f"{CNC_DATA_CONFLICT}: 参数D1({d1_val})必须小于毛坯直径({raw_diameter})"
+            )
+
+        # 检查安全距离是否为0
+        if safety_dis == 0:
+            raise ValueError("Safety distance (safety_dis) cannot be 0.")
+
+        std_params = db[std_key]
+
+        # 2. 准备参数字典，明确区分原始输入和预计算参数
+        raw_params = {"STD_KEY": std_key, "groove_type": gtype, "side": side}
+
+        derived_params: dict[str, Any] = {
+            "X_START": raw_diameter + 2 * safety_dis,
+            "R": float(std_params["r"]),
+        }
+
+        # 合并参数字典
+        context = {}
+        context.update(raw_params)
+        context.update(derived_params)
+
+        # 3. 计算 ES/FS 特有参数
+        # 所有中间变量计算都在这里完成，模板只负责变量替换
+        if gtype == "ES":
+            # DB params: r, t1, f, ES_ang
+            ES_t1, ES_f, ES_ang = (
+                std_params["t1"],
+                std_params["f"],
+                std_params["ES_ang"],
+            )
+
+            # User params: ES_d1, ES_z, ES_d2, ES_c, ES_c_ang
+            # 使用断言确保这些值不为 None
+            assert (
+                ES_d1 is not None
+                and ES_z is not None
+                and ES_d2 is not None
+                and ES_c is not None
+                and ES_c_ang is not None
+            )
+
+            # 计算所有ES类型所需的中间变量
+            z_start, d1_cut, ang_1, d1_comp_start = self._calc_start_geometry(
+                ES_ang, ES_f, safety_dis, ES_z, side, ES_d1, ES_t1
+            )
+            tan_ES_c_ang = math.tan(math.radians(ES_c_ang)) if ES_c_ang != 0 else 0
+            d2_comp_cut = ES_d2 - 2 * ES_c * tan_ES_c_ang - 0.5
+
+            # 更新预计算参数
+            derived_params.update(
+                {
+                    "Z_START": z_start,
+                    "ES_Z": ES_z,
+                    "ES_D2": ES_d2,
+                    "D1_CUT": d1_cut,
+                    "ANG_1": ang_1,
+                    "D1_COMP_START": d1_comp_start,
+                    "D2_COMP_CUT": d2_comp_cut,
+                }
+            )
+            # 合并到上下文
+            context.update(derived_params)
+
+        elif gtype == "FS":
+            # DB params: r, t1, f, t2, FS_ang_1, FS_ang_2
+            FS_r, FS_t1, FS_f, FS_t2, FS_ang_1, FS_ang_2 = (
+                std_params["r"],
+                std_params["t1"],
+                std_params["f"],
+                std_params["t2"],
+                std_params["FS_ang_1"],
+                std_params["FS_ang_2"],
+            )
+
+            # User params: FS_d1, FS_z
+            # 使用断言确保这些值不为 None
+            assert FS_d1 is not None and FS_z is not None
+
+            # 计算所有FS类型所需的中间变量
+            z_start, d1_cut, ang_1, d1_comp_start = self._calc_start_geometry(
+                FS_ang_1, FS_f, safety_dis, FS_z, side, FS_d1, FS_t1
+            )
+
+            # 计算FS类型特有的中间变量
+            angle_mid = math.radians(45 - FS_ang_2 / 2)
+            tan_mid = (
+                math.tan(angle_mid)
+                if angle_mid not in [0, math.pi / 2, -math.pi / 2]
+                else float("inf")
+            )
+            mid_z_offset_core = FS_r / tan_mid
+            offset = FS_t2 - FS_r + mid_z_offset_core
+            z_mid_right = FS_z - offset
+            z_mid_left = FS_z + offset
+            z_mid = z_mid_right if side == "Right" else z_mid_left
+            fs_z_plus1 = FS_z + 1.0
+            fs_z_minus1 = FS_z - 1.0
+            ang_2 = 90 - FS_ang_2 if side == "Right" else 90 + FS_ang_2
+
+            # 更新预计算参数
+            derived_params.update(
+                {
+                    "Z_START": z_start,
+                    "D1_CUT": d1_cut,
+                    "ANG_1": ang_1,
+                    "D1_COMP_START": d1_comp_start,
+                    "Z_MID": z_mid,
+                    "FS_Z_PLUS1": fs_z_plus1,
+                    "FS_Z_MINUS1": fs_z_minus1,
+                    "ANG_2": ang_2,
+                }
+            )
+            # 合并到上下文
+            context.update(derived_params)
+
+        # 4. 使用Jinja2模板渲染输出
+        # raw_params已包含groove_type和side，无需重复设置
+        return self.template_parser.render_template("undercut_template.j2", context).strip()
+
+    def generate_batch(self, config: UndercutConfig) -> tuple[str, list[str]]:
+        """
+        批量生成越程槽代码
+
+        Returns:
+            Tuple[str, List[str]]: (完整的G代码字符串, 错误信息列表)
+        """
+        full_code = []
+        errors = []
+
+        for i, groove in enumerate(config.grooves):
+            try:
+                # 映射参数
+                params: dict[str, Any] = {
+                    "gtype": groove.gtype,
+                    "side": config.side,
+                    "raw_diameter": config.raw_diameter,
+                    "safety_dis": config.safety_dis,
+                    "std_key": groove.std_key,
+                }
+
+                if groove.gtype == "ES":
+                    params.update(
+                        {
+                            "ES_d1": groove.d1,
+                            "ES_z": groove.z,
+                            "ES_d2": groove.d2,
+                            "ES_c": groove.c,
+                            "ES_c_ang": groove.ang,
+                        }
+                    )
+                elif groove.gtype == "FS":
+                    params.update({"FS_d1": groove.d1, "FS_z": groove.z})
+
+                # 调用单行生成
+                code = self.generate(**params)
+                full_code.append(code)
+                full_code.append("")  # 空行分隔
+
+            except ValueError as ve:
+                msg = f"; Error (Row {i + 1}): {str(ve)}"
+                full_code.append(msg)
+                full_code.append("")
+                errors.append(f"Row {i + 1}: {str(ve)}")
+            except Exception as e:
+                msg = f"; Error (Row {i + 1}): Unexpected error {str(e)}"
+                full_code.append(msg)
+                full_code.append("")
+                errors.append(f"Row {i + 1}: {str(e)}")
+
+        return "\n".join(full_code), errors
