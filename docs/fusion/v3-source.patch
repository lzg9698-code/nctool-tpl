+    def get_values(self) -> dict[str, Any]:
+        """获取输入值"""
+        try:
+            values = {}
+            for var_name, widget in self.input_widgets.items():
+                data_type = self.variable_repo.get_data_type(var_name)
+                raw_value = widget.get() if hasattr(widget, "get") else ""
+
+                if data_type == "choice":
+                    # For choice type, get the actual value from the mapping
+                    display_text = raw_value
+                    value_type = self.variable_repo.get_value_type(var_name)
+
+                    try:
+                        # Get the actual value from the mapping
+                        if hasattr(self, "option_mapping") and display_text in self.option_mapping:
+                            actual_value = self.option_mapping[display_text]
+                        else:
+                            # If not in mapping, try to convert directly
+                            actual_value = self.variable_repo._convert_value(
+                                display_text, value_type
+                            )
+
+                        values[var_name] = actual_value
+
+                    except (ValueError, TypeError) as e:
+                        raise VariableInputValidationError(
+                            var_name, display_text, f"有效的{value_type}类型选项"
+                        ) from e
+
+                elif data_type == "float":
+                    if not raw_value:
+                        values[var_name] = 0.0
+                    else:
+                        try:
+                            values[var_name] = float(raw_value)
+                        except ValueError as e:
+                            raise VariableInputValidationError(
+                                var_name, raw_value, "小数/浮点数(例如 0.5)"
+                            ) from e
+
+                elif data_type == "int":
+                    if not raw_value:
+                        values[var_name] = 0
+                    else:
+                        try:
+                            values[var_name] = int(float(raw_value))
+                        except ValueError as e:
+                            raise VariableInputValidationError(
+                                var_name, raw_value, "整数(例如 100)"
+                            ) from e
+                else:
+                    values[var_name] = raw_value
+
+            return values
+        except Exception as e:
+            handle_exception(e, "获取输入值")
+            # 重新抛出异常，让调用者处理
+            raise
+
+    def set_values(self, values: dict[str, Any]) -> None:
+        for var_name, value in values.items():
+            if var_name in self.input_widgets:
+                widget = self.input_widgets[var_name]
+                data_type = self.variable_repo.get_data_type(var_name)
+
+                if data_type == "choice":
+                    # For choice type, convert the value to display text
+                    if hasattr(self, "value_to_display"):
+                        # Try to find matching display text
+                        display_text = None
+
+                        # First try exact match
+                        if value in self.value_to_display:
+                            display_text = self.value_to_display[value]
+                        else:
+                            # If no exact match, try string comparison
+                            str_value = str(value).strip()
+                            for val, text in self.value_to_display.items():
+                                if str(val) == str_value:
+                                    display_text = text
+                                    break
+
+                        if display_text is not None:
+                            widget.set(display_text)
+                            continue
+
+                    # Fallback to string representation
+                    widget.set(str(value))
+
+                elif isinstance(widget, ctk.CTkEntry):
+                    widget.delete(0, "end")
+                    widget.insert(0, str(value) if value is not None else "")
+
+                # Trigger validation and linked calculations
+                self._on_input_change(var_name)
+
+    def _focus_next_input(self, current_var: str) -> None:
+        try:
+            idx = self.input_order.index(current_var)
+        except ValueError:
+            return
+        for next_idx in range(idx + 1, len(self.input_order)):
+            next_var = self.input_order[next_idx]
+            widget = self.input_widgets.get(next_var)
+            if not widget:
+                continue
+            _focus_widget(widget)
+            break
+
+    def _on_input_change(self, var_name: str) -> None:
+        """输入改变时的处理逻辑"""
+        try:
+            widget = self.input_widgets.get(var_name)
+            if not widget:
+                return
+
+            raw_value = widget.get()
+
+            # 1. 执行数值校验
+            is_valid, error_msg = self.variable_repo.validate_value(var_name, raw_value)
+            error_label = self.error_labels.get(var_name)
+            if error_label:
+                if not is_valid:
+                    error_label.configure(text=f"({error_msg})")
+                    widget.configure(border_color="red")
+                else:
+                    error_label.configure(text="")
+                    widget.configure(border_color=COLOR_SECONDARY)
+
+            # 2. 转换实际值
+            try:
+                if self.variable_repo.get_data_type(var_name) == "choice":
+                    # Choice 类型已在 option_mapping 中处理
+                    actual_value = raw_value
+                else:
+                    actual_value = self.variable_repo._convert_value(
+                        raw_value, self.variable_repo.get_data_type(var_name)
+                    )
+            except Exception:
+                # 转换失败时保留原始字符串，交由后续保存逻辑校验
+                actual_value = raw_value
+
+            # 3. 触发主变量联动映射
+            self._trigger_master_associations(var_name)
+
+            # 4. 触发外部值变化回调（用于预览区域绑定）
+            if self.value_change_callback:
+                bound_area = self.variable_repo.get_bound_area(var_name)
+                self.value_change_callback(var_name, actual_value, bound_area)
+
+        except Exception as e:
+            handle_exception(e, f"变量 {var_name} 输入变化处理失败", show_dialog=False)
+
+    def _trigger_master_associations(self, master_var: str) -> None:
+        """触发主变量定义的关联联动数据映射"""
+        try:
+            widget = self.input_widgets.get(master_var)
+            if not widget:
+                return
+
+            # 获取当前主变量的值
+            raw_value = widget.get()
+
+            # 获取该变量定义的关联数据
+            associations = self.variable_repo.get_associations(master_var)
+            if not associations:
+                return
+
+            # 查找当前选项对应的关联映射
+            # associations 格式: {"Option1": {"VarA": 10, "VarB": 20}}
+            mapping = associations.get(raw_value)
+            if not mapping:
+                return
+
+            # 批量更新被动变量
+            for target_var, target_value in mapping.items():
+                if target_var in self.input_widgets:
+                    target_widget = self.input_widgets[target_var]
+                    is_readonly = self.variable_repo.is_read_only(target_var)
+
+                    if isinstance(target_widget, ctk.CTkEntry):
+                        if is_readonly:
+                            target_widget.configure(state="normal")
+                        target_widget.delete(0, "end")
+                        target_widget.insert(0, str(target_value))
+                        if is_readonly:
+                            target_widget.configure(state="disabled")
+                    elif isinstance(target_widget, ctk.CTkComboBox):
+                        # 对于选择框，尝试匹配显示文本
+                        if is_readonly:
+                            target_widget.configure(state="readonly")
+
+                        if hasattr(self, "value_to_display"):
+                            display_text = self.value_to_display.get(
+                                target_value, str(target_value)
+                            )
+                            target_widget.set(display_text)
+                        else:
+                            target_widget.set(str(target_value))
+
+                        if is_readonly:
+                            target_widget.configure(state="disabled")
+
+                    # 递归触发被更新变量的联动（如果它也有联动逻辑）
+                    self._on_input_change(target_var)
+
+        except Exception as e:
+            # 记录联动错误
+            handle_exception(e, f"变量 {master_var} 联动映射失败", show_dialog=False)
+
