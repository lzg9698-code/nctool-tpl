+            self.topmost_btn.configure(text="取消置顶" if is_topmost else "置顶")
+        except Exception as e:
+            self._update_status(f"置顶切换失败: {str(e)}", "error")
+
+    def _toggle_appearance(self) -> None:
+        try:
+            mode = self.ui_manager.toggle_appearance()
+            self._update_status(f"已切换为 {mode} 模式", "info")
+        except Exception as e:
+            self._update_status(f"主题切换失败: {str(e)}", "error")
+
+    def _refresh_all(self) -> None:
+        """刷新模板、变量仓库与界面配置"""
+        try:
+            self.template_parser.reload_config()
+            self.variable_repo.load()
+            self.sync_frame.load_config()
+            self._update_status("配置已刷新", "success")
+        except Exception as e:
+            self._update_status(f"刷新配置失败: {str(e)}", "error")
+
+
+def main() -> None:
+    try:
+        app = SyncTurningStandaloneApp()
+        app.mainloop()
+    except Exception as e:
+        handle_critical_error(e, "同步车独立应用主循环")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except KeyboardInterrupt:
+        sys.exit(0)
