+import re
+from contextlib import suppress
+
+import customtkinter as ctk
+
+
+class GCodeHighlighter:
+    """G代码高亮引擎"""
+
+    def __init__(self, text_widget):
+        self.text = text_widget
+        self._setup_tags()
+
+    def _setup_tags(self):
+        # 定义配色方案
+        schemes = {
+            "comment": {"foreground": "gray"},
+            "gcode": {"foreground": "#e67e22"},  # 橙色
+            "mcode": {"foreground": "#e74c3c"},  # 红色
+            "axis": {"foreground": "#27ae60"},  # 绿色
+            "param": {"foreground": "#2980b9"},  # 蓝色
+            "keyword": {"foreground": "#8e44ad"},  # 紫色
+            "jinja2": {"foreground": "#d33682"},  # 粉色
+            "jinja2_kw": {"foreground": "#cb4b16", "weight": "bold"},  # 深橙色加粗
+        }
+        for tag, style in schemes.items():
+            # 特殊处理 weight 属性，Tkinter tag_configure 不直接支持 weight 字符串，需要使用 font
+            if "weight" in style:
+                weight = style.pop("weight")
+                self.text.tag_configure(
+                    tag, font=ctk.CTkFont(family="Consolas", size=14, weight=weight), **style
+                )
+            else:
+                self.text.tag_configure(tag, **style)
+
+    def highlight(self):
+        content = self.text.get("1.0", "end")
+
+        # 1. 清除所有旧标签
+        for tag in ["comment", "gcode", "mcode", "axis", "param", "keyword", "jinja2", "jinja2_kw"]:
+            self.text.tag_remove(tag, "1.0", "end")
+
+        # 2. 定义匹配规则 (注意顺序和 \b 边界)
+        patterns = [
+            (r";.*|{#.*?#}", "comment"),
+            (r"(?i)\bG\d+(?:\.\d+)?\b", "gcode"),
+            (r"(?i)\bM\d+(?:\.\d+)?\b", "mcode"),
+            (r"(?i)\b[XYZCUVW][+\-]?\d*\.?\d*", "axis"),
+            (r"(?i)\b[FTPH][+\-]?\d*\.?\d*", "param"),
+            (
+                r"(?i)\b(L\d+|DC|I|J|K|DECKEL|PROBE|I_STEP|STEP_\d+|S1|S4|I_SPX|I_SPY|I_SPZ|I_SPX2|I_SPY2|I_SPZ2|XMW_1|YMW_1|ZMW_1|CMW_1|AROT|ROT|TRANS|ATRANS|I_R9|ANG|OR|NOT|RND|WAITM|GOTOF|GOTOB|IF|THEN|ELSE|ENDIF|LOOP|ENDLOOP|WHILE|ENDWHILE|STOPRE|DIAMON|DIAMOF|SETMS|GROUP_BEGIN|GROUP_END|MSG|GX73|GZ73|GZ273|M17|RET|DIACYC|CYCLE\d+|SETAL|R\d+|T\d+|D\d+)\b",
+                "keyword",
+            ),
+            (r"(\{\{.*?\}\}|\{\%.*?\%\}|\{\#.*?\#\})", "jinja2"),
+            (
+                r"\b(if|else|elif|endif|for|in|endfor|set|macro|endmacro|include|import|from|extends|block|endblock|filter|endfilter|with|endwith)\b",
+                "jinja2_kw",
+            ),
+        ]
+
+        # 3. 按照优先级应用标签
+        for pattern, tag in patterns:
+            try:
+                for match in re.finditer(pattern, content):
+                    start_idx = match.start()
+
+                    if tag == "jinja2_kw":
+                        prefix = content[:start_idx]
+                        last_open = max(prefix.rfind("{{"), prefix.rfind("{%"))
+                        last_close = max(prefix.rfind("}}"), prefix.rfind("%}"))
+                        if last_open == -1 or last_close > last_open:
+                            continue
+
+                    line_start = content.rfind("\n", 0, start_idx) + 1
+                    current_line_prefix = content[line_start:start_idx]
+
+                    if tag not in ["comment", "jinja2"] and ";" in current_line_prefix:
+                        continue
+
+                    start = f"1.0 + {start_idx} chars"
+                    end = f"1.0 + {match.end()} chars"
+                    self.text.tag_add(tag, start, end)
+            except re.error:
+                continue
+
+
+class GCodeTextbox(ctk.CTkTextbox):
+    """带高亮显示的G代码文本框"""
+
+    def __init__(self, *args, **kwargs):
+        state = kwargs.pop("state", "normal")
+        wrap = kwargs.pop("wrap", None)
+        undo = kwargs.pop("undo", None)
+        autoseparators = kwargs.pop("autoseparators", None)
+        max_undo = kwargs.pop("max_undo", None)
+
+        super().__init__(*args, **kwargs)
+
+        if state != "normal":
+            try:
+                self.configure(state=state)
+            except (ValueError, KeyError, TypeError):
+                with suppress(Exception):
+                    self._textbox.configure(state=state)
+
+        if wrap:
+            with suppress(Exception):
+                self._textbox.configure(wrap=wrap)
+
+        if undo is not None:
+            with suppress(Exception):
+                self._textbox.configure(undo=undo)
+        if autoseparators is not None:
+            with suppress(Exception):
+                self._textbox.configure(autoseparators=autoseparators)
+        if max_undo is not None:
+            with suppress(Exception):
+                self._textbox.configure(max_undo=max_undo)
+
+        self.highlighter = GCodeHighlighter(self._textbox)
+        self._after_id = None
+        self.bind("<KeyRelease>", self._on_change)
+        self._setup_autohide_scrollbar()
+
+    def _setup_autohide_scrollbar(self):
+        """设置滚动条自动隐藏/半透明逻辑"""
+        self._scrollbar_visible_color = ("#949494", "#555555")
+        self._scrollbar_hint_color = ("#E0E0E0", "#333333")
+
+        self.configure(scrollbar_button_color=self._scrollbar_hint_color)
+
+        self.bind(
+            "<Enter>",
+            lambda e: self.configure(scrollbar_button_color=self._scrollbar_visible_color),
+        )
+        self.bind(
+            "<Leave>", lambda e: self.configure(scrollbar_button_color=self._scrollbar_hint_color)
+        )
+
+    def _on_change(self, event=None):
+        if self._after_id:
+            self.after_cancel(self._after_id)
+        self._after_id = self.after(300, self._do_highlight)
+
+    def _do_highlight(self):
+        self.highlighter.highlight()
+        self._after_id = None
+
+    def insert(self, index, text, tags=None):
+        # None 防御: Tk insert 对 None 会抛 TclError，统一按空文本处理
+        safe_text = "" if text is None else text
+        super().insert(index, safe_text, tags)
+        self._on_change()
+
+    def delete(self, index1, index2=None):
+        super().delete(index1, index2)
+        self._on_change()
+
+    def set_text(self, text):
+        """快捷设置文本并触发高亮，自动处理禁用状态
+
+        None 统一按空文本处理，避免 Tk insert 抛 TclError。
+        """
+        safe_text = "" if text is None else text
+        try:
+            old_state = self.cget("state")
+            self.configure(state="normal")
+            self.delete("1.0", "end")
+            self.insert("end", safe_text)
+            self.configure(state=old_state)
+        except (ValueError, KeyError, TypeError):
+            try:
+                old_state = self._textbox.cget("state")
+                self._textbox.configure(state="normal")
+                self._textbox.delete("1.0", "end")
+                self._textbox.insert("end", safe_text)
+                self._textbox.configure(state=old_state)
+            except Exception:
+                # 最坏情况：直接调用父类原语，放弃状态恢复
+                super().delete("1.0", "end")
+                super().insert("end", safe_text)
