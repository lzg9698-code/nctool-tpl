+def get_base_dir() -> Path:
+    """
+    获取程序运行的物理根目录。
+    """
+    if getattr(sys, "frozen", False):
+        # 打包环境：优先使用 sys.executable，备选 sys.argv[0]
+        if hasattr(sys, "executable"):
+            return Path(sys.executable).parent.resolve()
+        else:
+            return Path(os.path.abspath(sys.argv[0])).parent.resolve()
+    else:
+        # 开发环境：utils.py 在 core 目录下，返回上一级的上一级
+        return Path(__file__).parent.parent.resolve()
+
+
+def get_resource_path(relative_path: str) -> Path:
+    """
+    获取【内置资源】文件的绝对路径。
+    用于获取打包在 exe 内部、不可修改的默认资源。
+    """
+    # 在 Nuitka/PyInstaller 环境中，__file__ 会指向临时解压目录中的文件位置
+    # utils.py 位于 core 目录下，其上级目录即为打包资源的根目录
+    base_path = Path(__file__).parent.parent
+
+    # 如果是内置的 json，尝试从内部 configs 文件夹寻找
+    if relative_path.endswith(".json"):
+        target_path = base_path / "configs" / relative_path
+        if target_path.exists():
+            return target_path
+
+    return base_path / relative_path
+
+
+def get_config_path(filename: str) -> Path:
+    """
+    获取配置文件路径。
+    优先级：
+    1. 程序同级的 configs/ 文件夹 (外部)
+    2. 程序同级目录 (外部)
+    3. 程序内部打包的 configs/ 文件夹 (内置)
+    """
+    base_path = get_base_dir()
+
+    # 1. 检查外部 configs 文件夹
+    ext_config_dir = base_path / "configs" / filename
+    if ext_config_dir.exists():
+        return ext_config_dir
+
+    # 2. 检查外部同级目录
+    ext_root_path = base_path / filename
+    if ext_root_path.exists():
+        return ext_root_path
+
+    # 3. 检查内置资源 (调用 get_resource_path)
+    internal_path = get_resource_path(filename)
+    if internal_path.exists():
+        return internal_path
+
+    # 如果都不存在，默认返回外部 configs 路径（用于创建新文件）
+    return base_path / "configs" / filename
