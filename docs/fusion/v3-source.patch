+"""模板解析与渲染引擎
+
+职责：
+- 扫描 / 管理 .j2 模板文件及其 YAML 配置（templates.yaml）
+- 递归提取模板变量（含子模板 / 宏的引用）
+- 渲染模板为 G-code 文本
+
+线程安全：所有共享状态（缓存、配置）的访问均通过 RLock 保护。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from threading import RLock
+from typing import Any
+
+import jinja2.nodes as nodes
+import yaml
+from jinja2 import Environment, FileSystemLoader, meta
+from jinja2.exceptions import TemplateNotFound, TemplateSyntaxError
+
+from core.exceptions import TemplateRenderError
+from core.interfaces import ErrorCallback
+from core.utils import get_config_path
+
+# Jinja2 内置名称 / 测试器 / 过滤器：不作为模板输入变量提取
+_JINJA_BUILTINS = frozenset(
+    {
+        "loop",
+        "range",
+        "true",
+        "false",
+        "none",
+        "self",
+        "format",
+        "int",
+        "float",
+        "str",
+        "list",
+        "dict",
+        "length",
+        "upper",
+        "lower",
+        "trim",
+        "default",
+        "macros",
+        "recursive",
+        "callable",
+        "defined",
+        "divisibleby",
+        "equalto",
+        "escaped",
+    }
+)
+
+# 模板默认输出扩展名（templates.yaml 未配置时使用）
+DEFAULT_OUTPUT_EXTENSION = ".NC"
+
+
+@dataclass
+class TemplateCache:
+    """模板缓存项"""
+
+    file_hash: str
+    variables: list[str]
+    timestamp: float  # 预留字段：后续可用于 TTL 失效策略
+
+
+class TemplateParser:
+    """模板解析器（带缓存）"""
+
+    # 元数据搜索行数（检查文件头部注释）
+    METADATA_SEARCH_LINES = 10
+
+    def __init__(
+        self,
+        templates_dir: str,
+        error_callback: ErrorCallback | None = None,
+        enable_cache: bool = True,
+    ):
+        self.templates_dir = Path(templates_dir)
+        self.error_callback = error_callback
+        self.enable_cache = enable_cache
+        self._cache: dict[str, TemplateCache] = {}
+        self._lock = RLock()
+
+        self.env = self._build_environment()
+        self.yaml_config_path = get_config_path("templates.yaml")
+        self.template_configs: dict[str, dict[str, Any]] = self._load_yaml_config()
+
+    # ------------------------------------------------------------------
+    # 环境构建
+    # ------------------------------------------------------------------
+
+    def _build_environment(self) -> Environment:
+        """构建 Jinja2 环境，并注册模板全局函数与过滤器"""
+        env = Environment(
+            loader=FileSystemLoader(str(self.templates_dir)),
+            autoescape=False,
+            trim_blocks=True,  # 移除块后的第一个换行符
+            lstrip_blocks=True,  # 移除块前的制表符/空格
+        )
+        env.globals.update(
+            {
+                "sin": lambda x: math.sin(math.radians(x)),
+                "cos": lambda x: math.cos(math.radians(x)),
+                "tan": lambda x: math.tan(math.radians(x)),
+                "sqrt": math.sqrt,
+                "abs": abs,
+                "radians": math.radians,
+                "degrees": math.degrees,
+                "pi": math.pi,
+                "floor": math.floor,
+                "ceil": math.ceil,
+                "round": round,
+                "time": time.strftime("%Y-%m-%d %H:%M:%S"),
+            }
+        )
+        env.filters.update(
+            {
+                "fmt_coord": lambda v: f"{float(v):+.3f}",  # 强制显示正负号，3位小数
+                "fmt_val": lambda v: f"{float(v):.3f}",  # 不带正号，3位小数
+            }
+        )
+        return env
+
+    # ------------------------------------------------------------------
+    # YAML 模板配置管理
+    # ------------------------------------------------------------------
+
+    def _load_yaml_config(self) -> dict[str, dict[str, Any]]:
+        """从 YAML 加载模板配置"""
+        if not self.yaml_config_path.exists():
+            return {}
+        try:
+            with self._lock, open(self.yaml_config_path, encoding="utf-8") as f:
+                config = yaml.safe_load(f)
+                return config.get("templates", {})
+        except Exception as e:
+            if self.error_callback:
+                self.error_callback(f"加载 templates.yaml 失败: {str(e)}")
+            return {}
+
+    def update_template_config(self, template_path: str, config: dict) -> None:
+        """更新单个模板的配置并保存到 YAML"""
+        with self._lock:
+            self.template_configs[template_path] = config
+            self._save_yaml_config()
+            self.reload_config()
+
+    def _save_yaml_config(self) -> None:
+        """将当前配置保存回 YAML 文件"""
+        try:
+            # 使用临时文件 + 原子替换，避免写入中断导致配置损坏
+            data = {"templates": self.template_configs}
+            tmp_path = self.yaml_config_path.with_suffix(self.yaml_config_path.suffix + ".tmp")
+            with self._lock:
+                with open(tmp_path, "w", encoding="utf-8") as f:
+                    yaml.dump(data, f, allow_unicode=True, sort_keys=True)
+                tmp_path.replace(self.yaml_config_path)
+        except Exception as e:
+            if self.error_callback:
+                self.error_callback(f"保存 templates.yaml 失败: {str(e)}")
+
+    def reload_config(self) -> None:
+        """重新加载 YAML 配置文件"""
+        with self._lock:
+            self.template_configs = self._load_yaml_config()
+            self.clear_cache()
+
+    # ------------------------------------------------------------------
+    # 模板扫描与查询
+    # ------------------------------------------------------------------
+
+    def _iter_template_files(self) -> Iterator[tuple[str, Path]]:
+        """遍历模板目录下所有 .j2 文件
+
+        产出:
+            (相对路径字符串, 文件路径) 元组；相对路径统一使用 "/" 分隔
+        """
+        if not self.templates_dir.exists():
+            return
+        for f in self.templates_dir.rglob("*.j2"):
+            rel_path = f.relative_to(self.templates_dir)
+            yield str(rel_path).replace("\\", "/"), f
+
+    def get_all_templates_raw(self) -> list[dict[str, Any]]:
+        """获取文件系统中所有模板及其当前配置 (用于配置编辑器)"""
+        try:
+            templates = []
+            for path_str, f in self._iter_template_files():
+                with self._lock:
+                    cfg = self.template_configs.get(path_str, {})
+                metadata = self._extract_metadata(f)
+
+                templates.append(
+                    {
+                        "path": path_str,
+                        "name": cfg.get("name") or metadata.get("name") or path_str,
+                        "visible": cfg.get("visible", True),
+                        "output_filename": cfg.get("output_filename", ""),
+                        "output_extension": cfg.get("output_extension", DEFAULT_OUTPUT_EXTENSION),
+                        "description": cfg.get("description") or metadata.get("description", ""),
+                        "is_in_config": path_str in self.template_configs,
+                    }
+                )
+            return sorted(templates, key=lambda x: x["path"])
+        except Exception as e:
+            raise TemplateRenderError(f"获取原始模板列表失败: {str(e)}") from e
+
+    def get_template_list(self) -> list[dict[str, str]]:
+        """获取所有可用模板列表，根据 YAML 配置决定可见性"""
+        try:
+            templates = []
+            for path_str, f in self._iter_template_files():
+                # 获取 YAML 配置
+                with self._lock:
+                    cfg = self.template_configs.get(path_str, {})
+
+                # 检查可见性 (默认为 true，除非在 YAML 中显式设置为 false)
+                if not cfg.get("visible", True):
+                    continue
+
+                try:
+                    metadata = self._extract_metadata(f)
+
+                    # 优先级：YAML 配置 > 模板文件头 > 文件名
+                    name = cfg.get("name") or metadata.get("name")
+                    if not name:
+                        continue
+
+                    description = cfg.get("description") or metadata.get("description", "")
+
+                    templates.append(
+                        {
+                            "path": path_str,
+                            "name": name,
+                            "description": description,
+                        }
+                    )
+                except ValueError:
+                    continue
+            return sorted(templates, key=lambda x: x["name"])
+        except Exception as e:
+            raise TemplateRenderError(f"获取模板列表失败: {str(e)}") from e
+
+    def get_output_settings(self, template_path: str) -> dict[str, str]:
+        """获取模板的输出设置 (文件名和后缀)"""
+        with self._lock:
+            cfg = self.template_configs.get(template_path, {})
+        return {
+            "filename": cfg.get("output_filename", ""),
+            "extension": cfg.get("output_extension", DEFAULT_OUTPUT_EXTENSION),
+        }
+
+    def _extract_metadata(self, file_path: Path) -> dict:
+        """从文件头部注释提取元数据 (NAME, DESCRIPTION)"""
+        metadata = {"name": "", "description": ""}
+        try:
+            with open(file_path, encoding="utf-8") as f:
+                for _ in range(self.METADATA_SEARCH_LINES):
+                    line = f.readline()
+                    if not line:
+                        break
+                    if "{# NAME:" in line:
+                        metadata["name"] = line.split("{# NAME:")[1].split("#}")[0].strip()
+                    if "{# DESCRIPTION:" in line:
+                        metadata["description"] = (
+                            line.split("{# DESCRIPTION:")[1].split("#}")[0].strip()
+                        )
+        except Exception:
+            pass
+        return metadata
+
+    # ------------------------------------------------------------------
+    # 缓存管理
+    # ------------------------------------------------------------------
+
+    def _compute_hash(self, file_path: Path) -> str:
+        """计算文件的 MD5 哈希值
+
+        参数:
+            file_path: 文件路径
+
+        返回:
+            MD5 哈希字符串
+        """
+        return hashlib.md5(file_path.read_bytes()).hexdigest()
+
+    def _get_from_cache(self, template_name: str) -> list[str] | None:
+        """从缓存中获取变量列表
+
+        参数:
+            template_name: 模板名
+
+        返回:
+            变量列表（如果缓存有效且未过期），否则返回 None
+        """
+        if not self.enable_cache:
+            return None
+
+        with self._lock:
+            if template_name not in self._cache:
+                return None
+
+            cached = self._cache[template_name]
+            file_path = self.templates_dir / template_name
+
+            # 检查文件是否存在
+            if not file_path.exists():
+                del self._cache[template_name]
+                return None
+
+            # 检查文件哈希是否变化
+            current_hash = self._compute_hash(file_path)
+            if cached.file_hash != current_hash:
+                del self._cache[template_name]
+                return None
+
+            return cached.variables
+
+    def _update_cache(self, template_name: str, variables: list[str]) -> None:
+        """更新缓存
+
+        参数:
+            template_name: 模板名
+            variables: 变量列表
+        """
+        if not self.enable_cache:
+            return
+
+        file_path = self.templates_dir / template_name
+        file_hash = self._compute_hash(file_path)
+
+        with self._lock:
+            self._cache[template_name] = TemplateCache(
+                file_hash=file_hash, variables=variables, timestamp=time.time()
+            )
+
+    def clear_cache(self) -> None:
+        """清除所有缓存"""
+        with self._lock:
+            self._cache.clear()
+
+    # ------------------------------------------------------------------
+    # 变量提取（AST 扫描 + 递归引用）
+    # ------------------------------------------------------------------
+
+    def extract_variables(self, template_name: str) -> list[str]:
+        """递归提取模板及其引用的所有子模板/宏中的变量，包括宏内部变量"""
+        try:
+            # 尝试从缓存获取
+            cached_vars = self._get_from_cache(template_name)
+            if cached_vars is not None:
+                return cached_vars
+
+            # 未命中缓存，执行提取
+            all_undeclared_vars: set[str] = set()
+            visited: set[str] = set()
+            self._recursive_extract(template_name, visited, all_undeclared_vars)
+
+            vars_list = sorted(all_undeclared_vars)
+
+            # 更新缓存
+            self._update_cache(template_name, vars_list)
+
+            return vars_list
+        except Exception as e:
+            # 如果整个过程失败，返回空列表而不是崩溃
+            if self.error_callback:
+                self.error_callback(e, "提取模板变量失败", show_dialog=False)
+            return []
+
+    def _recursive_extract(self, name: str, visited: set[str], undeclared: set[str]) -> None:
+        """递归提取单个模板及其引用子模板/宏的变量
+
+        参数:
+            name: 模板名
+            visited: 已访问模板集合（防止循环引用）
+            undeclared: 未声明变量收集集合（输出）
+        """
+        if name in visited:
+            return
+        visited.add(name)
+        try:
+            with self._lock, self._local_search_path(name):
+                source, _, _ = self.env.loader.get_source(self.env, name)
+                ast = self.env.parse(source)
+
+                # 使用深度优先搜索遍历 AST
+                self._scan_ast_for_variables(ast, undeclared=undeclared)
+
+                # 查找引用的模板 (import, include, extend)
+                referenced = meta.find_referenced_templates(ast)
+                for ref in referenced:
+                    if ref:
+                        self._recursive_extract(ref, visited, undeclared)
+        except Exception as e:
+            # 遇到错误时记录但不中断整个过程
+            if self.error_callback:
+                self.error_callback(e, f"递归解析变量失败 ({name})", show_dialog=False)
+
+    def _scan_ast_for_variables(
+        self,
+        node: Any,
+        local_vars: set[str] | None = None,
+        undeclared: set[str] | None = None,
+    ) -> None:
+        """递归扫描 AST 节点，收集模板输入变量
+
+        参数:
+            node: Jinja2 AST 节点
+            local_vars: 当前作用域的局部变量集合（宏参数、set 赋值、import 别名）
+            undeclared: 收集到的未声明变量集合（输出）
+
+        说明:
+            local_vars 为可变集合，赋值语句会原地更新（副作用与嵌套作用域语义一致）
+        """
+        if local_vars is None:
+            local_vars = set()
+        if undeclared is None:
+            undeclared = set()
+
+        # 1. 处理宏定义：宏名称本身在该作用域下视为局部变量，避免被当作输入变量
+        if isinstance(node, nodes.Macro):
+            local_vars.add(node.name)
+            # 宏内部的作用域包含其参数
+            new_locals = local_vars | {arg.name for arg in node.args if isinstance(arg, nodes.Name)}
+            for child in node.body:
+                self._scan_ast_for_variables(child, new_locals, undeclared)
+            return
+
+        # 2. 处理导入：将导入的别名或名称视为局部变量
+        if isinstance(node, nodes.Import):
+            local_vars.add(node.target)
+
+        if isinstance(node, nodes.FromImport):
+            for name in node.names:
+                if isinstance(name, tuple):  # (original_name, alias)
+                    local_vars.add(name[1])
+                else:
+                    local_vars.add(name)
+
+        # 3. 如果是赋值语句，将目标视为局部变量
+        if isinstance(node, (nodes.Assign, nodes.AssignBlock)):
+            # 提取赋值目标中的变量名
+            targets = set()
+            for target in node.iter_child_nodes():
+                if isinstance(target, nodes.Name):
+                    targets.add(target.name)
+
+            # 扫描右侧表达式（使用当前的 locals）
+            if hasattr(node, "node"):  # set x = expr
+                self._scan_ast_for_variables(node.node, local_vars, undeclared)
+
+            # 更新局部变量集合
+            local_vars.update(targets)
+            return
+
+        # 4. 如果是 Name 节点且是 Load 状态，且不在内置/全局/局部变量中
+        if (
+            isinstance(node, nodes.Name)
+            and node.ctx == "load"
+            and node.name not in _JINJA_BUILTINS
+            and node.name not in self.env.globals
+            and node.name not in local_vars
+        ):
+            undeclared.add(node.name)
+
+        # 5. 递归遍历子节点
+        for child in node.iter_child_nodes():
+            self._scan_ast_for_variables(child, local_vars, undeclared)
+
+    # ------------------------------------------------------------------
+    # 渲染
+    # ------------------------------------------------------------------
+
+    @contextmanager
+    def _local_search_path(self, template_name: str) -> Iterator[None]:
+        """上下文管理器：临时将当前模板所在的目录加入搜索路径，以支持局部导入 (如 macros.j2)"""
+        template_path = self.templates_dir / template_name
+        local_dir = str(template_path.parent)
+
+        original_paths = self.env.loader.searchpath
+        try:
+            # 将本地目录放在最前面，实现“局部优先”
+            if local_dir not in original_paths:
+                self.env.loader.searchpath = [local_dir] + original_paths
+            yield
+        finally:
+            self.env.loader.searchpath = original_paths
+
+    def render_template(self, template_name: str, variables: dict[str, Any]) -> str:
+        """渲染模板"""
+        try:
+            # 渲染时动态注入本地目录，解决宏找不到的问题
+            with self._lock, self._local_search_path(template_name):
+                template = self.env.get_template(template_name)
+                return template.render(**variables)
+        except TemplateNotFound as e:
+            raise TemplateRenderError(f"找不到模板文件: {template_name}", template_name) from e
+        except TemplateSyntaxError as e:
+            raise TemplateRenderError(
+                f"模板语法错误 [{template_name}:{e.lineno}]: {e.message}", template_name
+            ) from e
+        except Exception as e:
+            raise TemplateRenderError(
+                f"渲染模板失败 [{template_name}]: {str(e)}", template_name
+            ) from e
