+"""
+模板渲染性能测试
+验证模板解析和渲染的性能
+"""
+
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from core.template_engine import TemplateParser
+
+
+class TestTemplatePerformance:
+    """模板性能测试"""
+
+    @pytest.mark.slow
+    def test_extract_variables_with_cache(self, benchmark):
+        """测试带缓存的变量提取性能"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            # 创建测试模板
+            template_path = Path(tmpdir) / "test_template.j2"
+            template_path.write_text("{{ var1 }} and {{ var2 }} and {{ var3 }}")
+
+            parser = TemplateParser(tmpdir, enable_cache=True)
+
+            # 第一次调用会缓存（预热）
+            parser.extract_variables("test_template.j2")
+
+            # 第二次使用缓存
+            result = benchmark(parser.extract_variables, "test_template.j2")
+
+            assert isinstance(result, list)
+
+    @pytest.mark.slow
+    def test_render_performance(self, benchmark):
+        """测试模板渲染性能"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            # 创建测试模板
+            template_path = Path(tmpdir) / "simple_template.j2"
+            template_path.write_text("Value: {{ value }}")
+
+            parser = TemplateParser(tmpdir)
+            variables = {"value": 42.0}
+
+            result = benchmark(parser.render_template, "simple_template.j2", variables)
+            assert isinstance(result, str)
+            assert "42" in result
+
+    @pytest.mark.slow
+    def test_math_functions_performance(self, benchmark):
+        """测试数学函数性能"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            template_path = Path(tmpdir) / "math_template.j2"
+            template_path.write_text("Sin90={{ '%.1f'|format(sin(90)) }}")
+
+            parser = TemplateParser(tmpdir)
+
+            result = benchmark(parser.render_template, "math_template.j2", {})
+            assert "1.0" in result
