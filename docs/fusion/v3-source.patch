+"""变量仓库：管理所有可用变量的定义、描述、默认值与类型转换"""
+
+import json
+from pathlib import Path
+from typing import Any
+
+from core.exceptions import ConfigLoadError, ConfigSaveError
+
+
+def _convert_bool(value: Any) -> bool:
+    """将字符串 / 其他类型转换为布尔值
+
+    字符串按常见布尔表示识别（不区分大小写）；非字符串走 Python 真值语义。
+    """
+    if isinstance(value, str):
+        return value.lower() in ("true", "1", "t", "y", "yes")
+    return bool(value)
+
+
+class VariableRepository:
+    """变量仓库: 管理所有可用变量的定义、描述和默认值"""
+
+    # 类型转换器映射
+    _TYPE_CONVERTERS = {
+        "int": lambda v: int(float(v)),
+        "float": float,
+        "bool": _convert_bool,
+        "str": str,
+    }
+
+    def __init__(self, repo_path: str, lazy_load: bool = True):
+        """
+        初始化变量仓库
+
+        参数:
+            repo_path: 仓库配置文件路径
+            lazy_load: 是否延迟加载（默认 True）
+        """
+        self.repo_path = Path(repo_path)
+        self.lazy_load = lazy_load
+        self._loaded = False
+        self.variables: dict[str, dict[str, Any]] = {}
+
+        if not lazy_load:
+            self._ensure_loaded()
+
+    def _ensure_loaded(self) -> None:
+        """确保配置已加载"""
+        if not self._loaded:
+            # 内存已有数据时，视为已加载，避免覆盖未保存修改
+            if self.variables:
+                self._loaded = True
+                return
+            try:
+                self.load()
+                self._loaded = True
+            except Exception:
+                # 加载失败时使用空仓库
+                self.variables = {}
+                self._loaded = True
+
+    # ------------------------------------------------------------------
+    # 加载 / 保存
+    # ------------------------------------------------------------------
+
+    def load(self) -> None:
+        """加载变量仓库配置
+
+        抛出:
+            ConfigLoadError: 当配置文件不存在、无权限或格式错误时
+        """
+        try:
+            if not self.repo_path.exists():
+                raise ConfigLoadError(
+                    f"变量仓库配置文件不存在: {self.repo_path}", str(self.repo_path)
+                )
+
+            with open(self.repo_path, encoding="utf-8") as f:
+                self.variables = json.load(f)
+        except (FileNotFoundError, PermissionError) as e:
+            raise ConfigLoadError(
+                f"无法访问配置文件 {self.repo_path}: {str(e)}", str(self.repo_path)
+            ) from e
+        except json.JSONDecodeError as e:
+            raise ConfigLoadError(f"变量仓库配置文件格式错误: {str(e)}", str(self.repo_path)) from e
+        except Exception as e:
+            raise ConfigLoadError(f"加载变量仓库配置失败: {str(e)}", str(self.repo_path)) from e
+
+    def save(self) -> None:
+        """保存变量仓库配置
+
+        抛出:
+            ConfigSaveError: 当保存失败时
+        """
+        try:
+            tmp_path = self.repo_path.with_suffix(self.repo_path.suffix + ".tmp")
+            with open(tmp_path, "w", encoding="utf-8") as f:
+                json.dump(self.variables, f, ensure_ascii=False, indent=4)
+            tmp_path.replace(self.repo_path)
+        except (PermissionError, OSError) as e:
+            raise ConfigSaveError(
+                f"无法写入配置文件 {self.repo_path}: {str(e)}", str(self.repo_path)
+            ) from e
+        except Exception as e:
+            raise ConfigSaveError(f"保存变量仓库配置失败: {str(e)}", str(self.repo_path)) from e
+
+    # ------------------------------------------------------------------
+    # 查询接口
+    # ------------------------------------------------------------------
+
+    def get_description(self, var_name: str) -> str:
+        """
+        获取变量描述
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            变量描述，如果不存在则返回变量名
+        """
+        self._ensure_loaded()
+
+        if var_name in self.variables:
+            return self.variables[var_name].get("description", var_name)
+        return var_name
+
+    def get_default(self, var_name: str) -> Any:
+        """
+        获取变量默认值（原始值，不做类型转换）
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            默认值，如果不存在则返回空字符串
+        """
+        self._ensure_loaded()
+
+        if var_name in self.variables:
+            var_data = self.variables[var_name]
+            if isinstance(var_data, dict):
+                return var_data.get("default_value", "")
+            return var_data  # 兼容旧格式
+        return ""
+
+    def get_data_type(self, var_name: str) -> str:
+        """
+        获取变量数据类型
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            数据类型（"str", "int", "float", "bool", "choice"）
+        """
+        self._ensure_loaded()
+
+        if var_name in self.variables:
+            return self.variables[var_name].get("data_type", "str")
+        return "str"
+
+    def is_read_only(self, var_name: str) -> bool:
+        """检查变量是否为只读（从变量）
+
+        注意: 本方法未调用 _ensure_loaded()（保持历史行为）；
+        若实例以 lazy_load=True 创建且从未触发加载，结果基于内存中的空仓库。
+        """
+        if var_name in self.variables:
+            return self.variables[var_name].get("read_only", False)
+        return False
+
+    def get_value_type(self, var_name: str) -> str:
+        """获取 choice 变量的值类型（"str"/"int"/"float"/"bool"）
+
+        注意: 本方法未调用 _ensure_loaded()（保持历史行为）。
+        """
+        if var_name in self.variables:
+            return self.variables[var_name].get("value_type", "str").lower()
+        return "str"
+
+    def get_options(self, var_name: str) -> list[str]:
+        """获取 choice 选项的显示文本
+
+        注意: 本方法未调用 _ensure_loaded()（保持历史行为）。
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            显示文本列表；无选项时返回空列表
+        """
+        if var_name in self.variables:
+            options = self.variables[var_name].get("options", [])
+            if not options:
+                return []
+
+            # 字符串列表：直接返回
+            if isinstance(options[0], str):
+                return options
+
+            # dict 列表（含 value/display）：返回 display 字段
+            if isinstance(options[0], dict):
+                return [str(opt.get("display", "")) for opt in options]
+
+        return []
+
+    def get_option_values(self, var_name: str) -> list:
+        """获取 choice 选项的实际值（按 value_type 做类型转换）
+
+        注意: 本方法未调用 _ensure_loaded()（保持历史行为）。
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            转换后的值列表；无选项时返回空列表
+        """
+        if var_name not in self.variables:
+            return []
+
+        options = self.variables[var_name].get("options", [])
+        if not options:
+            return []
+
+        value_type = self.get_value_type(var_name)
+
+        # 字符串列表
+        if isinstance(options[0], str):
+            return [self._convert_value(opt, value_type) for opt in options]
+
+        # dict 列表（含 value/display）
+        if isinstance(options[0], dict):
+            return [self._convert_value(opt.get("value"), value_type) for opt in options]
+
+        return []
+
+    def get_default_value(self, var_name: str) -> Any:
+        """获取默认值（choice 类型会按 value_type 做类型转换）
+
+        注意: 本方法未调用 _ensure_loaded()（保持历史行为）。
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            转换后的默认值；变量不存在时返回空字符串
+        """
+        if var_name not in self.variables:
+            return ""
+
+        default_val = self.variables[var_name].get("default_value", "")
+        if self.get_data_type(var_name) == "choice":
+            value_type = self.get_value_type(var_name)
+            return self._convert_value(default_val, value_type)
+
+        return default_val
+
+    def exists(self, var_name: str) -> bool:
+        """
+        检查变量是否存在
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            变量是否存在
+        """
+        self._ensure_loaded()
+        return var_name in self.variables
+
+    def get_variable_config(self, var_name: str) -> dict[str, Any]:
+        """获取变量的完整配置"""
+        self._ensure_loaded()
+        return self.variables.get(var_name, {})
+
+    def get_bound_area(self, var_name: str) -> str:
+        """
+        获取变量绑定的预览区域
+
+        参数:
+            var_name: 变量名
+
+        返回:
+            绑定区域名称，未配置时返回"无绑定"
+        """
+        self._ensure_loaded()
+        var_data = self.variables.get(var_name)
+        if isinstance(var_data, dict):
+            return str(var_data.get("bound_area", "无绑定") or "无绑定")
+        return "无绑定"
+
+    def get_bound_area_vars(self, area_name: str) -> list[str]:
+        """
+        获取绑定到指定区域的所有变量
+
+        参数:
+            area_name: 区域名称（如 "SYNC_LEFT"）
+
+        返回:
+            变量名列表
+        """
+        self._ensure_loaded()
+        return [
+            var_name
+            for var_name, config in self.variables.items()
+            if config.get("bound_area") == area_name
+        ]
+
+    def find_bound_variable(self, area_name: str) -> str | None:
+        """查找绑定到指定区域的变量名"""
+        self._ensure_loaded()
+        for name, cfg in self.variables.items():
+            if cfg.get("bound_area") == area_name:
+                return name
+        return None
+
+    def get_associations(self, var_name: str) -> dict[str, dict[str, Any]]:
+        """获取主变量的关联映射数据"""
+        config = self.get_variable_config(var_name)
+        return config.get("associations", {})
+
+    # ------------------------------------------------------------------
+    # 写操作
+    # ------------------------------------------------------------------
+
+    def set_default(self, var_name: str, value: Any) -> bool:
+        """
+        设置变量默认值
+
+        参数:
+            var_name: 变量名
+            value: 新的默认值
+
+        返回:
+            是否发生了变化
+        """
+        self._ensure_loaded()
+
+        if var_name not in self.variables:
+            return False
+
+        var_data = self.variables[var_name]
+
+        # 统一处理新旧格式
+        if not isinstance(var_data, dict):
+            self.variables[var_name] = {
+                "description": var_name,
+                "default_value": value,
+                "data_type": "str",
+            }
+            return True
+
+        # 检查是否真的发生了变化
+        old_value = var_data.get("default_value")
+        if old_value == value:
+            return False
+
+        var_data["default_value"] = value
+        return True
+
+    def update_defaults(self, values: dict[str, Any]) -> bool:
+        """批量更新默认值
+
+        返回:
+            是否有任何变量发生了变化
+        """
+        self._ensure_loaded()
+        any_changed = False
+        for var_name, value in values.items():
+            if self.set_default(var_name, value):
+                any_changed = True
+        return any_changed
+
+    def update_variable(self, var_name: str, data: dict[str, Any]) -> None:
+        """整体更新变量配置（内存操作，不触发加载/保存）"""
+        self.variables[var_name] = data
+
+    def add_variable(
+        self,
+        var_name: str,
+        description: str = "",
+        data_type: str = "float",
+        default_value: Any = "",
+        **kwargs: Any,
+    ) -> None:
+        """添加新变量（内存操作，不触发加载/保存）"""
+        self.variables[var_name] = {
+            "description": description or var_name,
+            "data_type": data_type,
+            "default_value": default_value,
+            "bound_area": kwargs.get("bound_area", "无绑定"),
+            **kwargs,
+        }
+
+    def delete_variable(self, var_name: str) -> None:
+        """删除变量（内存操作，不触发加载/保存）"""
+        if var_name in self.variables:
+            del self.variables[var_name]
+
+    # ------------------------------------------------------------------
+    # 校验与类型转换
+    # ------------------------------------------------------------------
+
+    def validate_value(self, var_name: str, value: Any) -> tuple[bool, str]:
+        """校验值是否在有效范围内
+
+        参数:
+            var_name: 变量名
+            value: 要验证的值
+
+        返回:
+            (是否通过, 错误信息)
+        """
+        if var_name not in self.variables:
+            return True, ""
+
+        config = self.variables[var_name]
+        data_type = config.get("data_type", "str")
+
+        if data_type in ["int", "float"]:
+            try:
+                val = float(value)
+                min_val = config.get("min_value")
+                max_val = config.get("max_value")
+
+                if min_val is not None and val < float(min_val):
+                    return False, f"最小值不能小于 {min_val}"
+                if max_val is not None and val > float(max_val):
+                    return False, f"最大值不能超过 {max_val}"
+            except (ValueError, TypeError):
+                return False, "无效的数值格式"
+
+        return True, ""
+
+    def _convert_value(self, value: Any, value_type: str) -> Any:
+        """
+        转换值为指定类型
+
+        参数:
+            value: 原始值
+            value_type: 目标类型 ("int", "float", "bool", "str")
+
+        返回:
+            转换后的值，转换失败则返回原始值
+        """
+        if value is None or value == "":
+            return None
+
+        converter = self._TYPE_CONVERTERS.get(value_type)
+        if converter:
+            try:
+                return converter(value)
+            except (ValueError, TypeError):
+                pass
+
+        return value
