+
+**实现**：
+```python
+class TemplateParser:
+    def __init__(self, templates_dir: str, enable_cache: bool = True):
+        self.enable_cache = enable_cache
+        self._cache: dict[str, TemplateCache] = {}
+
+    def extract_variables(self, template_name: str) -> list[str]:
+        # 检查缓存
+        cached = self._get_from_cache(template_name)
+        if cached:
+            return cached
+
+        # 提取变量
+        vars_list = self._extract_variables_internal(template_name)
+
+        # 更新缓存
+        self._update_cache(template_name, vars_list)
+        return vars_list
+```
