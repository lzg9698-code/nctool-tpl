classDiagram
    %% ERR-NUM-PRECISION 修复 · 类图（v2 · 主理人已裁定）
    %% 注意：本设计改动面极小 —— 只改 nctool-tpl 的两个过滤器函数，无新增类型、无新增模块。
    %% 本图刻画 filters.rs 内受影响函数、其调用方与 core 侧治理层的关系（供实现与验证定位）。
    %%
    %% v1 -> v2 变更：采用硬失败（原 v1 否决）；nc_signed 同步施加硬失败；TemplateGovernance 由「待裁定」变为「裁定不做」。

    class FiltersMod {
        <<nctool-tpl src/filters.rs>>
        +filter_nc_fixed(value f64, decimals usize) Result~String, Error~  [★ 本次修改]
        +filter_nc_signed(value f64, decimals usize) Result~String, Error~ [★ 本次修改]
        +filter_nc_strip(value f64) Result~String, Error~                  [不改]
        +filter_nc_pad(value f64, width usize) Result~String, Error~       [不改]
        +checked_math(value f64, filter &str) Result~f64, Error~           [不改]
        -MAX_NC_FIXED_DECIMALS usize = 32
        -MAX_NC_PAD_WIDTH usize = 1024
    }

    class NcFixedHardFail {
        <<本次改动的核心语义>>
        +有限性校验 : NaN/Inf -> Err
        +decimals 上界校验 : >32 -> Err
        +舍入后判零 : mag = format(%, .N, value.abs)
        +is_zero = mag 全为 '0' 或 '.'
        +【新】硬失败 : value != 0.0 && is_zero -> Err  [FORM_A 字符串判零, 唯一判据]
        +【新】负零归一后置 : sign = if value < 0.0 && !is_zero { "-" } else { "" }
        --旧行为: 舍入前 value==0.0 判零 -> -1e-4 漏归一 -> "-0.000"--
        --旧行为: 真值非零舍入为全零 -> 静默输出 "0.000"--
        --禁止: 用 |v| < 0.5*10^(-N) 量级式实现判据 (tie 点会错)--
    }

    class NcSignedHardFail {
        <<同步施加（阈值相同，原亦静默）>>
        +既有 : 舍入后字符串判零, 负数正确归 +0.000
        +【新】硬失败 : value != 0.0 && is_zero -> Err
        +既有行为保留 : nc_signed(-0.0) -> "+0.000"
    }

    class NcFixedContract {
        <<文档契约 (写入 doc comment)>>
        +丢值即报错判据 [FORM_A]: v != 0.0 && 舍入后的输出串全为零 => Err
        +禁止量级式 [FORM_B]: |v| < 0.5*10^(-N) 在 tie 点不一致, 不得实现
        +tie 点行为: 0.5|nc_fixed(0) => Err (舍入后确实得 "0")
        +tie 点行为: 0.0005|nc_fixed(3) => "0.001" (舍入后非零, 不报错)
        +负零归一必须在舍入之后
        +需要更小量级 : 用 nc_fixed(4+) 或 nc_strip
    }

    class Minijinja {
        <<外部引擎, 不改>>
        +注册过滤器
        +渲染时按名调用 filter_nc_fixed
        +返回 Err => 渲染失败(硬失败) ★ 本项目红线所期望的行为
    }

    class ValidationLayer {
        <<nctool-core, 本次不改>>
        +IssueKind (NonFinite / OutOfRange / ...)
        +is_hard_fail()
        +【已知限制】过滤器无法向本层上报 Issue (无通道)
        +【裁定】该限制是特性, 非障碍: 红线要求宁可渲染失败
    }

    class TemplateGovernance {
        <<templates/*.yaml + *.j2>>
        +【裁定】本次不动 variables.yaml / 模板 (T04 取消)
        +原因: U_RC 加 min 会误挡工艺合理的 0.04mm
        +原因: 机制修复后落带即报错, 用户立刻可见
    }

    class GoldenRegression {
        <<core/tests/integration.rs + tests/golden>>
        +builtin_templates_match_golden_matrix (46 文件, 不变)
        +【实测】真 golden 27 值 × N∈{0..4} => 新报错 0 / 输出变化 0
        +【新增】uz_rkm_temp* / undercut* golden (当前零覆盖)
        +【新增】必须含「落带即 Err」的负向 case
    }

    FiltersMod --> NcFixedHardFail : 实现
    FiltersMod --> NcSignedHardFail : 实现
    NcFixedHardFail ..> NcFixedContract : 遵循
    NcSignedHardFail ..> NcFixedContract : 遵循
    Minijinja ..> FiltersMod : 按名调用
    FiltersMod ..> ValidationLayer : 无上报通道 (C3, 架构限制)
    TemplateGovernance ..> FiltersMod : 生产调用方 (真实面全为物理量, 不落带)
    GoldenRegression ..> FiltersMod : 回归保护
