# Rust 构建产物
/target

# WorkBuddy 项目运行数据（本地记忆、任务状态等）
.workbuddy-ai/
.workbuddy/

# 编辑器 / 系统临时文件
*.swp
*.swo
.idea/
.vscode/
# AI 编程助手的本地配置（含 settings.local.json）——与 .vscode/ 同类，
# 属本地环境而非仓库内容；不忽略会被 `git add -A` 顺手提交。
.claude/
.DS_Store
Thumbs.db

# 日志与临时输出
*.log

# Python 字节码缓存（运行 scripts/*.py 或 py_compile 会生成；
# 属生成物，误提交会污染仓库）
__pycache__/
*.pyc

# 覆盖率产物（CI 的 coverage job 与本地 `cargo llvm-cov` 都在仓库根生成，
# 属生成物而非源文件；漏了这行会让 `git add -A` 顺手把它们提交进去）
/lcov.info
/coverage-summary.txt

# 本地配置：会向上递归查找到文件系统根，放在仓库里会污染 E2E 测试
# （测试在临时目录执行，但若仓库根存在 nctool.toml，测试会意外读到它）
/nctool.toml

# AI 编程助手的本地计划文件（同 .claude/）
.zcode/

# 桌面 GUI 前端（Tauri 2 + React）构建产物
gui/frontend/node_modules/
gui/frontend/dist/
# Vite 本地环境文件可能含部署地址或令牌；仅允许提交无机密示例文件。
gui/frontend/.env
gui/frontend/.env.*
!gui/frontend/.env.example
# tauri-build 生成的 ACL/权限 schema（每次构建自动重建，不提交）
gui/gen/schemas/


# Vite 打包配置时生成的临时文件（vite.config.ts.timestamp-*.mjs）
*.timestamp-*
