                  "type": {
                    "type": "string",
                    "title": "过渡",
                    "enum": [
                      "line",
                      "arc"
                    ]
                  },
                  "length": {
                    "type": "number",
                    "title": "切线长度 / mm",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "radius": {
                    "type": "number",
                    "title": "圆弧半径 / mm",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "angle": {
                    "type": "number",
                    "title": "扫角 / 度",
                    "exclusiveMinimum": 0,
                    "maximum": 180
                  },
                  "clearance": {
                    "type": "number",
                    "title": "径向间隙 / mm",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "feedPerRev": {
                    "type": "number",
                    "title": "过渡 F / mm/rev",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "clearanceFeedPerRev": {
                    "type": "number",
                    "title": "间隙 F / mm/rev",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  }
                },
                "title": "入刀"
              },
              "exit": {
                "type": "object",
                "additionalProperties": false,
