        "type": "object",
        "required": [
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "mode",
              "startZ",
              "startDiameter",
              "direction",
              "reverse",
              "cutting",
              "features",
              "entry",
              "exit",
              "stock",
              "forbidden"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "title": "项目版本",
                "enum": [
                  1
                ]
              },
              "mode": {
                "type": "string",
                "title": "加工侧",
                "enum": [
                  "outside",
                  "inside"
                ]
              },
              "startZ": {
                "type": "number",
                "title": "起始 Z / mm",
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "startDiameter": {
                "type": "number",
                "title": "起始直径 / mm",
                "exclusiveMinimum": 0,
                "maximum": 1000000000
              },
              "direction": {
                "type": "integer",
                "title": "定义方向",
                "enum": [
                  -1,
                  1
                ]
              },
              "reverse": {
                "type": "boolean",
                "title": "反向走刀"
              },
              "cutting": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "surfaceSpeedMPerMin",
                  "maxSpindleRpm"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "constant-surface-speed"
                    ],
                    "title": "切削模式"
                  },
                  "surfaceSpeedMPerMin": {
                    "type": "number",
                    "title": "线速度 / m/min",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "maxSpindleRpm": {
                    "type": "number",
                    "title": "最高转速 / rpm",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  }
                }
              },
              "features": {
                "type": "array",
                "title": "轮廓特征",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "feedPerRev",
                    "corner"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "title": "标识",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "type": {
                      "type": "string",
                      "title": "特征",
                      "enum": [
                        "cylinder",
                        "cone",
                        "face"
                      ]
                    },
                    "length": {
                      "type": "number",
                      "title": "轴向长度 / mm",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000000
                    },
                    "diameter": {
                      "type": "number",
                      "title": "终点直径 / mm",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000000
                    },
                    "feedPerRev": {
                      "type": "number",
                      "title": "本段 F / mm/rev",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000000
                    },
                    "corner": {
