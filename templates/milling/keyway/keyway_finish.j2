{# NAME: 统一精铣键槽模板 (keyway_finish.j2) #}
{# 支持: 闭口非圆头/闭口圆头/左开口/右开口, 一次走刀到最终尺寸 #}
{# 切削参数由core层计算后传入: finish_n, finish_vf #}
{# 走刀路径决策由core层计算后传入: path_type (closed_non_round/closed_round/right_open/left_open) #}

;----精铣键槽子程序----
{% include 'milling/keyway/_keyway_header.j2' %}

{# ---- 刀具定位 ---- #}
{% if path_type in ['closed_non_round', 'closed_round'] %}
    G94 G40 G0 X0 Y0 C=DC(0.00)
{% else %}
    G94 G40 G0 X={{ "%.3f" | format(U_FTD / 2 + 5) }} Y0 C=DC(0.00)
{% endif %}
G0 Z10

{# ---- 入刀 (Z向分两段: 快进+慢进) ---- #}
G1 Z={{ "%.3f" | format(-(U_C - 5)) }} F3000
G1 Z={{ "%.3f" | format(-U_C) }} F100

{# ========== 精铣轮廓 ========== #}
{% if path_type == 'closed_non_round' %}
    {# ---- 闭口非圆头 ---- #}
    G1 G41 Y={{ "%.3f" | format(U_B / 2) }} F={{ "%.0f" | format(finish_vf) }}
    G1 X={{ "%.3f" | format(-U_A) }}
    G3 X={{ "%.3f" | format(-(U_A + U_Q)) }} Y={{ "%.3f" | format(U_B / 2 - U_Q) }} J={{ "%.3f" | format(-U_Q) }}
    G1 Y={{ "%.3f" | format(-(U_B / 2 - U_Q)) }}
    G3 X={{ "%.3f" | format(-U_A) }} Y={{ "%.3f" | format(-U_B / 2) }} I={{ "%.3f" | format(U_Q) }}
    G1 X0
    G3 X={{ "%.3f" | format(U_Q) }} Y={{ "%.3f" | format(-(U_B / 2 - U_Q)) }} J={{ "%.3f" | format(U_Q) }}
    G1 Y={{ "%.3f" | format(U_B / 2 - U_Q) }}
    G3 X0 Y={{ "%.3f" | format(U_B / 2) }} I={{ "%.3f" | format(-U_Q) }}
    G1 G40 Y0 Z2

{% elif path_type == 'closed_round' %}
    {# ---- 闭口圆头 (两端整圆, 半径=U_B/2) ---- #}
    G1 G41 Y={{ "%.3f" | format(U_B / 2) }} F={{ "%.0f" | format(finish_vf) }}
    G1 X={{ "%.3f" | format(-U_A) }}
    G3 X={{ "%.3f" | format(-U_A) }} Y={{ "%.3f" | format(-U_B / 2) }} J={{ "%.3f" | format(-U_B / 2) }}
    G1 X0
    G3 X0 Y={{ "%.3f" | format(U_B / 2) }} J={{ "%.3f" | format(U_B / 2) }}
    G1 G40 Y0 Z2

{% elif path_type == 'right_open' %}
    {# ---- 右开口非圆头 ---- #}
    G1 G41 Y={{ "%.3f" | format(U_B / 2) }} F={{ "%.0f" | format(finish_vf) }}
    G1 X={{ "%.3f" | format(-U_A) }}
    G3 X={{ "%.3f" | format(-(U_A + U_Q)) }} Y={{ "%.3f" | format(U_B / 2 - U_Q) }} J={{ "%.3f" | format(-U_Q) }}
    G1 Y={{ "%.3f" | format(-(U_B / 2 - U_Q)) }}
    G3 X={{ "%.3f" | format(-U_A) }} Y={{ "%.3f" | format(-U_B / 2) }} I={{ "%.3f" | format(U_Q) }}
    G1 X={{ "%.3f" | format(U_FTD / 2 + 5) }}
    G1 G40 Y0 Z2

{% elif path_type == 'left_open' %}
    {# ---- 左开口非圆头 (坐标系已旋转180°) ---- #}
    G1 G41 Y={{ "%.3f" | format(U_B / 2) }} F={{ "%.0f" | format(finish_vf) }}
    G1 X={{ "%.3f" | format(-U_A) }}
    G3 X={{ "%.3f" | format(-(U_A + U_Q)) }} Y={{ "%.3f" | format(U_B / 2 - U_Q) }} J={{ "%.3f" | format(-U_Q) }}
    G1 Y={{ "%.3f" | format(-(U_B / 2 - U_Q)) }}
    G3 X={{ "%.3f" | format(-U_A) }} Y={{ "%.3f" | format(-U_B / 2) }} I={{ "%.3f" | format(U_Q) }}
    G1 X={{ "%.3f" | format(U_FTD / 2 + 5) }}
    G1 G40 Y0 Z2
{% endif %}

{% include 'milling/keyway/_keyway_footer.j2' %}
