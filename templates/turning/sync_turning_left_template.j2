{# ========== 配置区 (逻辑计算在模板中进行) ========== #}
{# 接收原始参数: actual_sta_x, actual_sta_z, end_z, ap_1, ap_2, sync_num_start, cut_num #}
{# ==================================================== #}
{# ========== 轨迹生成区 ========== #}
;---SYT-Left--D{{ "%.1f"|format(end_x) }}---start---
G0 Z{{ "%.3f"|format(actual_sta_z) }}
G0 X{{ "%.3f"|format(actual_sta_x + 10) }}
WAITM({{ sync_num_start }},1,2)
{% for i in range(1, cut_num + 1) %}
{# --- 计算当前刀次的坐标 --- #}
{% set x_val_ch1 = actual_sta_x - ap_1 - (i - 1) * (ap_1 + ap_2) %}
{% set x_val_ch2 = actual_sta_x - i * (ap_1 + ap_2) %}
{% set z_base = actual_sta_z - (i-1) * (ap_1+ap_2)/(2*tan(25)) %}
{# 定义常量距离 #}
{% set dis_1 = 4.0 %}
{% set dis_2 = 8.0 %}
{# 计算各点位 #}
{% set z_start_ch1 = z_base + dis_1/2 %}
{% set z_start_ch2 = z_base + dis_2/2 %}
{% set x_target_ch1_app = x_val_ch1 + ap_1 + dis_1 %}
{% set x_target_ch2_app = x_val_ch2 + ap_1 + ap_2 + dis_2 %}
{# ------------------------ #}
{% if channel == 1 %}
G0 Z{{ "%.3f"|format(z_start_ch1) }}
G0 X{{ "%.3f"|format(x_target_ch1_app) }}
{% else %}
G0 Z{{ "%.3f"|format(z_start_ch2) }}
G0 X{{ "%.3f"|format(x_target_ch2_app) }}
{% endif %}
WAITM({{ sync_num_start + i }},1,2)
{% if channel == 1 %}
G1 Z{{ "%.3f"|format(z_base) }} ANG=225 F0.2
G1 X{{ "%.3f"|format(x_val_ch1) }} ANG=205 F0.2
{% else %}
G1 Z{{ "%.3f"|format(z_start_ch2 - dis_1/2) }} ANG=225 F0.2
G1 Z{{ "%.3f"|format(z_base) }} ANG=225 F0.2
G1 X{{ "%.3f"|format(x_val_ch2) }} ANG=205 F0.2
{% endif %}
G1 Z{{ "%.3f"|format(end_z) }} F{{ "%.1f"|format(sync_feed) }}
G91
G1 X{{ "%.3f"|format(ap_1 + ap_2 + 4) }} F40
G90
{% endfor %}
G0 X{{ "%.3f"|format(actual_sta_x + 10) }}
G0 Z{{ "%.3f"|format(end_z) }}
;---End---
