{# 参数文档表:============================
    必需输入变量:
    - groove_type: 工艺类型 ("ES" 或 "FS")
    - side: 侧面 ("Right" 或 "Left")
    - STD_KEY: 标准键值
    - X_START: 起始X坐标
    - R: 圆角半径

    ES类型特有变量:
    - Z_START: 起始Z坐标
    - ES_Z: ES Z坐标
    - ES_D2: ES D2值
    - D1_CUT: D1切割值
    - ANG_1: 角度1
    - D1_COMP_START: D1补偿起始值
    - D2_COMP_CUT: D2补偿切割值

    FS类型特有变量:
    - Z_START: 起始Z坐标
    - D1_CUT: D1切割值
    - ANG_1: 角度1
    - D1_COMP_START: D1补偿起始值
    - Z_MID: 中间Z坐标
    - FS_Z_PLUS1: FS Z+1坐标
    - FS_Z_MINUS1: FS Z-1坐标
    - ANG_2: 角度2

    计算规则:

    ES类型计算规则:
    1. 从数据库获取参数: ES_r, ES_t1, ES_f, ES_ang
    2. 用户输入参数: ES_d1, ES_z, ES_d2, ES_c, ES_c_ang
    3. 计算中间变量:
       - tan_ES_ang = tan(radians(ES_ang)) if ES_ang != 0 else inf
       - z_start_offset = ES_f + safety_dis / tan_ES_ang
       - Z_START = ES_z + z_start_offset (右侧) 或 ES_z - z_start_offset (左侧)
       - D1_CUT = ES_d1 - 2 * ES_t1
       - ANG_1 = ES_ang - 180 (右侧) 或 -ES_ang (左侧)
       - D1_COMP_START = ES_d1 + 2 * safety_dis
       - tan_ES_c_ang = tan(radians(ES_c_ang)) if ES_c_ang != 0 else 0
       - D2_COMP_CUT = ES_d2 - 2 * ES_c * tan_ES_c_ang - 0.5

    FS类型计算规则:
    1. 从数据库获取参数: FS_r, FS_t1, FS_f, FS_t2, FS_ang_1, FS_ang_2
    2. 用户输入参数: FS_d1, FS_z
    3. 计算中间变量:
       - tan_FS_ang_1 = tan(radians(FS_ang_1)) if FS_ang_1 != 0 else inf
       - z_start_offset = FS_f + safety_dis / tan_FS_ang_1
       - Z_START = FS_z + z_start_offset (右侧) 或 FS_z - z_start_offset (左侧)
       - D1_CUT = FS_d1 - 2 * FS_t1
       - ANG_1 = FS_ang_1 - 180 (右侧) 或 -FS_ang_1 (左侧)
       - D1_COMP_START = FS_d1 + 2 * safety_dis
       - angle_mid = radians(45 - FS_ang_2 / 2)
       - tan_mid = tan(angle_mid) if angle_mid not in [0, π/2, -π/2] else inf
       - mid_z_offset_core = FS_r / tan_mid
       - offset = FS_t2 - FS_r + mid_z_offset_core
       - Z_MID = FS_z - offset (右侧) 或 FS_z + offset (左侧)
       - FS_Z_PLUS1 = FS_z + 1.0
       - FS_Z_MINUS1 = FS_z - 1.0
       - ANG_2 = 90 - FS_ang_2 (右侧) 或 90 + FS_ang_2 (左侧)
=========================================== #}

{# ========== 配置区 (中间变量初始化) ========== #}
{# 所有中间变量已在Python侧预计算，此处无需计算 #}
{# ========================================== #}

{# ========== 轨迹生成区 ========== #}
{% if groove_type == "ES" and side == "Right" %}
{# ES类型右侧越程槽 #}
; --- ES_Right ({{ STD_KEY }}) ---
G0 Z{{ "%.3f"|format(Z_START) }}
G0 X{{ "%.3f"|format(X_START) }}
M4=97
G0 G42 X{{ "%.3f"|format(D1_COMP_START) }}
G1 X{{ "%.3f"|format(D1_CUT) }} ANG={{ "%.0f"|format(ANG_1) }} RND={{ "%.1f"|format(R) }} F0.2
G1 Z{{ "%.3f"|format(ES_Z) }} RND={{ "%.1f"|format(R) }}
G1 X{{ "%.3f"|format(D2_COMP_CUT) }}
G1 X{{ "%.3f"|format(ES_D2) }} ANG=135
G0 G40 X{{ "%.3f"|format(X_START) }}
; --------------------------------------
{% elif groove_type == "ES" and side == "Left" %}
{# ES类型左侧越程槽 #}
; --- ES_Left ({{ STD_KEY }}) ---
G0 Z{{ "%.3f"|format(Z_START) }}
G0 X{{ "%.3f"|format(X_START) }}
M4=97
G0 G41 X{{ "%.3f"|format(D1_COMP_START) }}
G1 X{{ "%.3f"|format(D1_CUT) }} ANG={{ "%.0f"|format(ANG_1) }} RND={{ "%.1f"|format(R) }} F0.2
G1 Z{{ "%.3f"|format(ES_Z) }} RND={{ "%.1f"|format(R) }}
G1 X{{ "%.3f"|format(D2_COMP_CUT) }}
G1 X{{ "%.3f"|format(ES_D2) }} ANG=45
G0 G40 X{{ "%.3f"|format(X_START) }}
; --------------------------------------
{% elif groove_type == "FS" and side == "Right" %}
{# FS类型右侧越程槽 #}
; --- FS_Right ({{ STD_KEY }}) ---
G0 Z{{ "%.3f"|format(Z_START) }}
G0 X{{ "%.3f"|format(X_START) }}
M4=97
G0 G42 X{{ "%.3f"|format(D1_COMP_START) }}
G1 X{{ "%.3f"|format(D1_CUT) }} ANG={{ "%.0f"|format(ANG_1) }} RND={{ "%.1f"|format(R) }} F0.2
G1 Z{{ "%.3f"|format(Z_MID) }} RND={{ "%.1f"|format(R) }}
G1 Z{{ "%.3f"|format(FS_Z_PLUS1) }} ANG={{ "%.0f"|format(ANG_2) }}
G0 G40 X{{ "%.3f"|format(X_START) }}
; --------------------------------------
{% elif groove_type == "FS" and side == "Left" %}
{# FS类型左侧越程槽 #}
; --- FS_Left ({{ STD_KEY }}) ---
G0 Z{{ "%.3f"|format(Z_START) }}
G0 X{{ "%.3f"|format(X_START) }}
M4=97
G0 G41 X{{ "%.3f"|format(D1_COMP_START) }}
G1 X{{ "%.3f"|format(D1_CUT) }} ANG={{ "%.0f"|format(ANG_1) }} RND={{ "%.1f"|format(R) }} F0.2
G1 Z{{ "%.3f"|format(Z_MID) }} RND={{ "%.1f"|format(R) }}
G1 Z{{ "%.3f"|format(FS_Z_MINUS1) }} ANG={{ "%.0f"|format(ANG_2) }}
G0 G40 X{{ "%.3f"|format(X_START) }}
; --------------------------------------
{% endif %}
{# ================================ #}
